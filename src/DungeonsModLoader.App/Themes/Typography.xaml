<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

  <!--
    Typography tokens.

    Display font : Pixelify Sans (SIL OFL) - a chunky, readable pixel face that echoes the blocky game lettering
                   without copying the game's font. Used for headings, nav labels and the Play button.
    Body font    : Inter (SIL OFL) - clean UI sans for everything else.
    Both are bundled under Assets/Fonts with their OFL licence files.

    Scale (max 2 sizes per card): Display 32 / H1 24 / H2 18 / H3 15 / Body 14 / Small 12 / Caption 11.
  -->

  <FontFamily x:Key="Font.Display">pack://application:,,,/Assets/Fonts/#Pixelify Sans</FontFamily>
  <FontFamily x:Key="Font.Body">pack://application:,,,/Assets/Fonts/#Inter</FontFamily>
  <FontFamily x:Key="Font.Mono">Cascadia Mono, Consolas, Courier New</FontFamily>

  <sys:Double x:Key="FontSize.Display">32</sys:Double>
  <sys:Double x:Key="FontSize.H1">24</sys:Double>
  <sys:Double x:Key="FontSize.H2">18</sys:Double>
  <sys:Double x:Key="FontSize.H3">15</sys:Double>
  <sys:Double x:Key="FontSize.Body">14</sys:Double>
  <sys:Double x:Key="FontSize.Small">12</sys:Double>
  <sys:Double x:Key="FontSize.Caption">11</sys:Double>
  <sys:Double x:Key="FontSize.Button">14</sys:Double>
  <sys:Double x:Key="FontSize.Nav">15</sys:Double>

  <!-- Base text style: body font, primary colour. Everything else derives from it. -->
  <Style x:Key="Text.Base" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Font.Body}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <Style x:Key="Text.Display" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
    <Setter Property="FontFamily" Value="{StaticResource Font.Display}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.Display}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Accent.Light}" />
  </Style>

  <Style x:Key="Text.H1" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
    <Setter Property="FontFamily" Value="{StaticResource Font.Display}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.H1}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style x:Key="Text.H2" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
    <Setter Property="FontFamily" Value="{StaticResource Font.Display}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.H2}" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>

  <Style x:Key="Text.H3" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
    <Setter Property="FontSize" Value="{StaticResource FontSize.H3}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style x:Key="Text.Body" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style x:Key="Text.Secondary" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
    <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}" />
  </Style>

  <Style x:Key="Text.Small" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
    <Setter Property="FontSize" Value="{StaticResource FontSize.Small}" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}" />
  </Style>

  <Style x:Key="Text.Caption" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
    <Setter Property="FontSize" Value="{StaticResource FontSize.Caption}" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Text.Muted}" />
  </Style>

  <!-- Section labels such as "WEAPONS" / "ARMOR" in the inventory screen: small, semi-bold, muted. -->
  <Style x:Key="Text.Label" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
    <Setter Property="FontSize" Value="{StaticResource FontSize.Small}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}" />
  </Style>

  <Style x:Key="Text.Mono" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
    <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.Small}" />
  </Style>

</ResourceDictionary>
