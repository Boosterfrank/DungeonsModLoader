<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:controls="clr-namespace:DungeonsModLoader.App.Controls"
                    xmlns:conv="clr-namespace:DungeonsModLoader.App.Converters">

  <!--
    Control theme (merged by App.xaml after Colors.xaml and Typography.xaml).

    One dictionary on purpose: WPF resolves StaticResource references inside a merged dictionary against
    the application-level dictionaries (Colors / Typography) and against keys defined EARLIER IN THE SAME
    FILE - keys in sibling sub-dictionaries are not visible (they come back as UnsetValue / "cannot find
    resource" when a template is applied). Keeping everything here makes every reference safe.

    Sections (in dependency order):
      1. Shared   focus ring, local effect/thickness tokens, glyph geometries, converters
      2. Buttons  Button.* variants (extruded 3D face), ToggleSwitch, Chip
      3. Inputs   TextBox, PasswordBox, TextBox.Search, ComboBox(+Item), CheckBox, RadioButton
      4. Lists    ListBox(+Item), ScrollViewer, ScrollBar
      5. Misc     ProgressBar, ToolTip, ContextMenu, MenuItem, Separator/Divider, Card, Badge, Hyperlink

    Consumers reference keyed styles with {DynamicResource ...}; implicit styles apply automatically.
    Only tokens from Colors.xaml / Typography.xaml are used; the few local tokens are derived from them.
  -->

  <!-- ================================================================================================ -->
  <!-- 1. SHARED -->
  <!-- ================================================================================================ -->

  <!--
    Shared building blocks for the control theme.
    Everything here uses only the tokens from Colors.xaml / Typography.xaml; the few local tokens below
    are derived from them (same colours, different blur/opacity or packaged as a Thickness).
  -->

  <!-- ============================ Focus ring ============================ -->
  <!-- Keyboard-only focus indicator (WPF shows FocusVisualStyle for keyboard navigation only). -->
  <Style x:Key="FocusVisual">
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <Border Margin="-2"
                  BorderBrush="{StaticResource Brush.Cyan}"
                  BorderThickness="2"
                  CornerRadius="{StaticResource Radius.Small}"
                  SnapsToDevicePixels="True"
                  UseLayoutRounding="True" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============================ Local tokens ============================ -->
  <!-- Softer cyan glow for secondary buttons, focused inputs and toggle knobs (Effect.Glow.Cyan at low opacity). -->
  <DropShadowEffect x:Key="Effect.Glow.Cyan.Soft" Color="{StaticResource Color.Cyan}" BlurRadius="12" ShadowDepth="0" Opacity="0.3" />
  <!-- Stronger accent glow for the Play button. -->
  <DropShadowEffect x:Key="Effect.Glow.Accent.Strong" Color="{StaticResource Color.Accent}" BlurRadius="24" ShadowDepth="0" Opacity="0.85" />

  <!-- The 3D extrusion as margins: at rest the face sits above the edge, pressed it sinks onto it. -->
  <Thickness x:Key="Thickness.Extrude.Rest">0,0,0,3</Thickness>
  <Thickness x:Key="Thickness.Extrude.Pressed">0,3,0,0</Thickness>
  <Thickness x:Key="Thickness.Extrude.Large.Rest">0,0,0,4</Thickness>
  <Thickness x:Key="Thickness.Extrude.Large.Pressed">0,4,0,0</Thickness>

  <sys:Double x:Key="Opacity.Disabled">0.45</sys:Double>

  <!--
    Pill radii as explicit half-heights. Radius.Pill (999) only looks right when width ~ height: WPF's Border
    clamps the X and Y radius of each corner separately, so a 999 radius on a wide, short element draws
    elliptical "lens" ends instead of semicircles.
  -->
  <CornerRadius x:Key="Radius.Pill.Chip">14</CornerRadius>
  <CornerRadius x:Key="Radius.Pill.Toggle">12</CornerRadius>
  <CornerRadius x:Key="Radius.Pill.Bar">4</CornerRadius>
  <CornerRadius x:Key="Radius.Pill.Thin">3</CornerRadius>

  <!-- ============================ Glyph geometries (stroked, 16px design grid) ============================ -->
  <Geometry x:Key="Geometry.Chevron.Down">M1,1 L5,5 L9,1</Geometry>
  <Geometry x:Key="Geometry.Chevron.Right">M1,1 L5,5 L1,9</Geometry>
  <Geometry x:Key="Geometry.Check">M2,7 L5.5,10.5 L12,3.5</Geometry>
  <Geometry x:Key="Geometry.Search">M5.5,1 A4.5,4.5 0 1 1 5.5,10 A4.5,4.5 0 1 1 5.5,1 Z M8.9,8.9 L13,13</Geometry>

  <!-- ============================ Converters ============================ -->
  <conv:BoolToVisibilityConverter x:Key="Converter.BoolToVisibility" />
  <conv:BoolToVisibilityConverter x:Key="Converter.BoolToVisibility.Inverse" Invert="True" />
  <conv:BoolToVisibilityConverter x:Key="Converter.BoolToVisibility.Hidden" FalseVisibility="Hidden" />
  <conv:NullToVisibilityConverter x:Key="Converter.NullToVisibility" />
  <conv:NullToVisibilityConverter x:Key="Converter.NullToVisibility.Inverse" Invert="True" />
  <conv:InverseBoolConverter x:Key="Converter.InverseBool" />
  <conv:FilePathToImageConverter x:Key="Converter.FileToImage" />
  <conv:FilePathToImageConverter x:Key="Converter.FileToImageBrush" AsBrush="True" />

  <!-- ================================================================================================ -->
  <!-- 2. BUTTONS -->
  <!-- ================================================================================================ -->

  <!--
    Buttons, toggle switch and filter chips.

    Button anatomy (like the extruded letters of the game logo):
      GlowLayer  - same footprint as the control, carries the hover glow, faded in/out by storyboard
      Back       - darker "3D" edge filling the control (controls:ButtonHelper.ExtrudeBrush)
      Face       - the coloured face, 3px shorter than the control; pressed it sinks onto the edge
    Face / bevel / text colours come from Background / BorderBrush / Foreground so the four
    extruded variants (Primary, Secondary, Danger, Play) share the template and only differ in setters.
  -->

  <!-- ============================ Templates ============================ -->

  <!-- Extruded button: 3px edge. -->
  <ControlTemplate x:Key="Template.Button.Extruded" TargetType="Button">
    <Grid x:Name="Root" Background="Transparent" SnapsToDevicePixels="True" UseLayoutRounding="True">
      <Border x:Name="GlowLayer"
              Background="{TemplateBinding controls:ButtonHelper.ExtrudeBrush}"
              CornerRadius="{StaticResource Radius.Small}"
              Effect="{TemplateBinding controls:ButtonHelper.Glow}"
              Opacity="0" />
      <Border x:Name="Back"
              Background="{TemplateBinding controls:ButtonHelper.ExtrudeBrush}"
              CornerRadius="{StaticResource Radius.Small}" />
      <Border x:Name="Face"
              Margin="{StaticResource Thickness.Extrude.Rest}"
              Padding="{TemplateBinding Padding}"
              Background="{TemplateBinding Background}"
              BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="{TemplateBinding BorderThickness}"
              CornerRadius="{StaticResource Radius.Small}">
        <ContentPresenter x:Name="Content"
                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                          RecognizesAccessKey="True"
                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
      </Border>
    </Grid>
    <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Trigger.EnterActions>
          <BeginStoryboard>
            <Storyboard>
              <DoubleAnimation Storyboard.TargetName="GlowLayer" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource Duration.Fast}" />
            </Storyboard>
          </BeginStoryboard>
        </Trigger.EnterActions>
        <Trigger.ExitActions>
          <BeginStoryboard>
            <Storyboard>
              <DoubleAnimation Storyboard.TargetName="GlowLayer" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource Duration.Normal}" />
            </Storyboard>
          </BeginStoryboard>
        </Trigger.ExitActions>
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter TargetName="Face" Property="Margin" Value="{StaticResource Thickness.Extrude.Pressed}" />
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter TargetName="Root" Property="Opacity" Value="{StaticResource Opacity.Disabled}" />
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <!-- Extruded button, large: 4px edge (Play). -->
  <ControlTemplate x:Key="Template.Button.Extruded.Large" TargetType="Button">
    <Grid x:Name="Root" Background="Transparent" SnapsToDevicePixels="True" UseLayoutRounding="True">
      <Border x:Name="GlowLayer"
              Background="{TemplateBinding controls:ButtonHelper.ExtrudeBrush}"
              CornerRadius="{StaticResource Radius.Medium}"
              Effect="{TemplateBinding controls:ButtonHelper.Glow}"
              Opacity="0" />
      <Border x:Name="Back"
              Background="{TemplateBinding controls:ButtonHelper.ExtrudeBrush}"
              CornerRadius="{StaticResource Radius.Medium}" />
      <Border x:Name="Face"
              Margin="{StaticResource Thickness.Extrude.Large.Rest}"
              Padding="{TemplateBinding Padding}"
              Background="{TemplateBinding Background}"
              BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="{TemplateBinding BorderThickness}"
              CornerRadius="{StaticResource Radius.Medium}">
        <ContentPresenter x:Name="Content"
                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                          RecognizesAccessKey="True"
                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
      </Border>
    </Grid>
    <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Trigger.EnterActions>
          <BeginStoryboard>
            <Storyboard>
              <DoubleAnimation Storyboard.TargetName="GlowLayer" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource Duration.Fast}" />
            </Storyboard>
          </BeginStoryboard>
        </Trigger.EnterActions>
        <Trigger.ExitActions>
          <BeginStoryboard>
            <Storyboard>
              <DoubleAnimation Storyboard.TargetName="GlowLayer" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource Duration.Normal}" />
            </Storyboard>
          </BeginStoryboard>
        </Trigger.ExitActions>
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter TargetName="Face" Property="Margin" Value="{StaticResource Thickness.Extrude.Large.Pressed}" />
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter TargetName="Root" Property="Opacity" Value="{StaticResource Opacity.Disabled}" />
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <!-- Flat button: no extrusion (Ghost, Icon). Hover/pressed fills come from style triggers on Background. -->
  <ControlTemplate x:Key="Template.Button.Flat" TargetType="Button">
    <Border x:Name="Root"
            Padding="{TemplateBinding Padding}"
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            CornerRadius="{StaticResource Radius.Small}"
            SnapsToDevicePixels="True"
            UseLayoutRounding="True">
      <ContentPresenter x:Name="Content"
                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                        RecognizesAccessKey="True"
                        SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
    </Border>
    <ControlTemplate.Triggers>
      <Trigger Property="IsEnabled" Value="False">
        <Setter TargetName="Root" Property="Opacity" Value="{StaticResource Opacity.Disabled}" />
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <!-- ============================ Button styles ============================ -->

  <!-- Shared metrics / typography for every button variant. -->
  <Style x:Key="Button.Base" TargetType="Button">
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
    <Setter Property="FontFamily" Value="{StaticResource Font.Body}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.Button}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Height" Value="{StaticResource Size.Control.Height}" />
    <Setter Property="MinWidth" Value="96" />
    <Setter Property="Padding" Value="{StaticResource Padding.Button}" />
    <Setter Property="BorderThickness" Value="{StaticResource Thickness.Border.Thin}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="UseLayoutRounding" Value="True" />
    <Setter Property="Template" Value="{StaticResource Template.Button.Extruded}" />
  </Style>

  <!-- Primary: the ONE gold action per screen. -->
  <Style x:Key="Button.Primary" TargetType="Button" BasedOn="{StaticResource Button.Base}">
    <Setter Property="Background" Value="{StaticResource Brush.Accent.Gradient}" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Accent.Dark}" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Text.OnAccent}" />
    <Setter Property="controls:ButtonHelper.ExtrudeBrush" Value="{StaticResource Brush.Accent.Deep}" />
    <Setter Property="controls:ButtonHelper.Glow" Value="{StaticResource Effect.Glow.Accent}" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{StaticResource Brush.Accent.GradientHover}" />
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter Property="Background" Value="{StaticResource Brush.Accent.GradientPressed}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- Secondary: panel-coloured face, dark edge, faint cyan glow on hover. Also the implicit Button style. -->
  <Style x:Key="Button.Secondary" TargetType="Button" BasedOn="{StaticResource Button.Base}">
    <Setter Property="Background" Value="{StaticResource Brush.Panel.Gradient}" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Border.Strong}" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
    <Setter Property="controls:ButtonHelper.ExtrudeBrush" Value="{StaticResource Brush.Bevel.Dark}" />
    <Setter Property="controls:ButtonHelper.Glow" Value="{StaticResource Effect.Glow.Cyan.Soft}" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{StaticResource Brush.Bg.PanelAlt}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Bevel.Light}" />
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter Property="Background" Value="{StaticResource Brush.Bg.Input}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style TargetType="Button" BasedOn="{StaticResource Button.Secondary}" />

  <!-- Danger: uninstall / delete. -->
  <Style x:Key="Button.Danger" TargetType="Button" BasedOn="{StaticResource Button.Base}">
    <Setter Property="Background" Value="{StaticResource Brush.Danger.Gradient}" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Danger.Dark}" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Text.OnAccent}" />
    <Setter Property="controls:ButtonHelper.ExtrudeBrush" Value="{StaticResource Brush.Danger.Dark}" />
    <Setter Property="controls:ButtonHelper.Glow" Value="{StaticResource Effect.Glow.Danger}" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{StaticResource Brush.Danger.GradientHover}" />
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter Property="Background" Value="{StaticResource Brush.Danger}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- Ghost: text only, no extrusion. -->
  <Style x:Key="Button.Ghost" TargetType="Button" BasedOn="{StaticResource Button.Base}">
    <Setter Property="Template" Value="{StaticResource Template.Button.Flat}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{StaticResource Brush.Bg.PanelAlt}" />
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter Property="Background" Value="{StaticResource Brush.Bg.Panel}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- Icon: 32x32 glyph button (window chrome, row actions). Give Path content Fill bound to the button's Foreground. -->
  <Style x:Key="Button.Icon" TargetType="Button" BasedOn="{StaticResource Button.Base}">
    <Setter Property="Template" Value="{StaticResource Template.Button.Flat}" />
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="32" />
    <Setter Property="MinWidth" Value="32" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}" />
    <Setter Property="FontWeight" Value="Normal" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{StaticResource Brush.Bg.PanelAlt}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter Property="Background" Value="{StaticResource Brush.Bg.Panel}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- Play: the big always-visible launch button. Display font, 4px edge, strong glow. -->
  <Style x:Key="Button.Play" TargetType="Button" BasedOn="{StaticResource Button.Primary}">
    <Setter Property="Template" Value="{StaticResource Template.Button.Extruded.Large}" />
    <Setter Property="Height" Value="{StaticResource Size.Control.HeightLarge}" />
    <Setter Property="MinWidth" Value="160" />
    <Setter Property="Padding" Value="28,0,28,0" />
    <Setter Property="FontFamily" Value="{StaticResource Font.Display}" />
    <Setter Property="FontSize" Value="20" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="controls:ButtonHelper.Glow" Value="{StaticResource Effect.Glow.Accent.Strong}" />
  </Style>

  <!-- ============================ ToggleSwitch (ToggleButton) ============================ -->
  <!-- 44x24 pill track with an 18px knob that slides 3 -> 23 px; optional label content to the right. -->
  <Style x:Key="ToggleSwitch" TargetType="ToggleButton">
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
    <Setter Property="FontFamily" Value="{StaticResource Font.Body}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
    <Setter Property="Background" Value="{StaticResource Brush.Bg.Input}" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Border.Strong}" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="UseLayoutRounding" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <StackPanel x:Name="Root" Background="Transparent" Orientation="Horizontal">
            <Grid Width="44" Height="24" VerticalAlignment="Center">
              <Border x:Name="Track"
                      Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{StaticResource Thickness.Border.Thin}"
                      CornerRadius="{StaticResource Radius.Pill.Toggle}" />
              <Ellipse x:Name="Knob"
                       Width="18"
                       Height="18"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Center"
                       Fill="{StaticResource Brush.Text.Secondary}">
                <Ellipse.RenderTransform>
                  <TranslateTransform X="3" />
                </Ellipse.RenderTransform>
              </Ellipse>
            </Grid>
            <ContentPresenter x:Name="Label"
                              Margin="10,0,0,0"
                              VerticalAlignment="Center"
                              RecognizesAccessKey="True" />
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="Content" Value="{x:Null}">
              <Setter TargetName="Label" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Knob" Property="Fill" Value="{StaticResource Brush.Text.Primary}" />
              <Setter TargetName="Knob" Property="Effect" Value="{StaticResource Effect.Glow.Cyan.Soft}" />
              <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource Brush.Bevel.Light}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Track" Property="Background" Value="{StaticResource Brush.Success.Gradient}" />
              <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource Brush.Success.Dark}" />
              <Setter TargetName="Knob" Property="Fill" Value="{StaticResource Brush.Text.Primary}" />
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Knob"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                     To="23"
                                     Duration="{StaticResource Duration.Fast}" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Knob"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                     To="3"
                                     Duration="{StaticResource Duration.Fast}" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Root" Property="Opacity" Value="{StaticResource Opacity.Disabled}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============================ Chip (RadioButton) ============================ -->
  <!-- Pill filter chip: All / Enabled / Disabled / Updates. Group chips with GroupName. -->
  <Style x:Key="Chip" TargetType="RadioButton">
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
    <Setter Property="FontFamily" Value="{StaticResource Font.Body}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.Small}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}" />
    <Setter Property="Background" Value="{StaticResource Brush.Bg.Panel}" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
    <Setter Property="BorderThickness" Value="{StaticResource Thickness.Border.Thin}" />
    <Setter Property="Height" Value="{StaticResource Size.Control.HeightSmall}" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="UseLayoutRounding" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border x:Name="Root"
                  Padding="{TemplateBinding Padding}"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{StaticResource Radius.Pill.Chip}">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                              RecognizesAccessKey="True" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Root" Property="Opacity" Value="{StaticResource Opacity.Disabled}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{StaticResource Brush.Bg.PanelAlt}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border.Strong}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
      </Trigger>
      <Trigger Property="IsChecked" Value="True">
        <Setter Property="Background" Value="{StaticResource Brush.Accent.Faint}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Accent.Light}" />
        <Setter Property="FontWeight" Value="SemiBold" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- ================================================================================================ -->
  <!-- 3. INPUTS -->
  <!-- ================================================================================================ -->

  <!--
    Text inputs, combo box, check box and radio button.

    Field look shared by TextBox / PasswordBox / ComboBox: Brush.Bg.Input fill, 1px Brush.Border,
    Brush.Border.Strong on hover, Brush.Cyan + soft cyan glow while keyboard focus is inside.
    The watermark comes from controls:TextBoxHelper.Placeholder (HasText is maintained by the helper).
  -->

  <!-- ============================ TextBox ============================ -->
  <Style TargetType="TextBox">
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Height" Value="{StaticResource Size.Control.Height}" />
    <Setter Property="MinWidth" Value="120" />
    <Setter Property="Background" Value="{StaticResource Brush.Bg.Input}" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
    <Setter Property="BorderThickness" Value="{StaticResource Thickness.Border.Thin}" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="FontFamily" Value="{StaticResource Font.Body}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
    <Setter Property="CaretBrush" Value="{StaticResource Brush.Accent.Light}" />
    <Setter Property="SelectionBrush" Value="{StaticResource Brush.Cyan.Dim}" />
    <Setter Property="SelectionTextBrush" Value="{StaticResource Brush.Text.Primary}" />
    <Setter Property="SelectionOpacity" Value="0.55" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="AllowDrop" Value="True" />
    <Setter Property="ScrollViewer.PanningMode" Value="VerticalFirst" />
    <Setter Property="Stylus.IsFlicksEnabled" Value="False" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="UseLayoutRounding" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Grid x:Name="Root">
            <Border x:Name="Bd"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{StaticResource Radius.Small}" />
            <ScrollViewer x:Name="PART_ContentHost"
                          Margin="{TemplateBinding Padding}"
                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                          Focusable="False"
                          HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollBarVisibility="Hidden" />
            <TextBlock x:Name="Placeholder"
                       Margin="{TemplateBinding Padding}"
                       VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                       Foreground="{StaticResource Brush.Text.Muted}"
                       IsHitTestVisible="False"
                       Text="{TemplateBinding controls:TextBoxHelper.Placeholder}"
                       TextTrimming="CharacterEllipsis"
                       Visibility="Collapsed" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="controls:TextBoxHelper.HasText" Value="False">
              <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsReadOnly" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Bg.Panel}" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.Border.Strong}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.Cyan}" />
              <Setter TargetName="Bd" Property="Effect" Value="{StaticResource Effect.Glow.Cyan.Soft}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Root" Property="Opacity" Value="{StaticResource Opacity.Disabled}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Search field: same as TextBox plus a magnifier glyph on the left. -->
  <Style x:Key="TextBox.Search" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
    <Setter Property="Padding" Value="32,0,10,0" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Grid x:Name="Root">
            <Border x:Name="Bd"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{StaticResource Radius.Small}" />
            <Path x:Name="Glyph"
                  Width="14"
                  Height="14"
                  Margin="11,0,0,0"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Center"
                  Data="{StaticResource Geometry.Search}"
                  Stretch="Uniform"
                  Stroke="{StaticResource Brush.Text.Muted}"
                  StrokeEndLineCap="Round"
                  StrokeStartLineCap="Round"
                  StrokeThickness="1.75" />
            <ScrollViewer x:Name="PART_ContentHost"
                          Margin="{TemplateBinding Padding}"
                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                          Focusable="False"
                          HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollBarVisibility="Hidden" />
            <TextBlock x:Name="Placeholder"
                       Margin="{TemplateBinding Padding}"
                       VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                       Foreground="{StaticResource Brush.Text.Muted}"
                       IsHitTestVisible="False"
                       Text="{TemplateBinding controls:TextBoxHelper.Placeholder}"
                       TextTrimming="CharacterEllipsis"
                       Visibility="Collapsed" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="controls:TextBoxHelper.HasText" Value="False">
              <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.Border.Strong}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.Cyan}" />
              <Setter TargetName="Bd" Property="Effect" Value="{StaticResource Effect.Glow.Cyan.Soft}" />
              <Setter TargetName="Glyph" Property="Stroke" Value="{StaticResource Brush.Cyan}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Root" Property="Opacity" Value="{StaticResource Opacity.Disabled}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============================ PasswordBox ============================ -->
  <Style TargetType="PasswordBox">
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Height" Value="{StaticResource Size.Control.Height}" />
    <Setter Property="MinWidth" Value="120" />
    <Setter Property="Background" Value="{StaticResource Brush.Bg.Input}" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
    <Setter Property="BorderThickness" Value="{StaticResource Thickness.Border.Thin}" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="FontFamily" Value="{StaticResource Font.Body}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
    <Setter Property="CaretBrush" Value="{StaticResource Brush.Accent.Light}" />
