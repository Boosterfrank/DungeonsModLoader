<UserControl x:Class="DungeonsModLoader.App.Views.Pages.InstalledPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:DungeonsModLoader.App.Controls"
             xmlns:vm="clr-namespace:DungeonsModLoader.App.ViewModels.Pages"
             xmlns:core="clr-namespace:DungeonsModLoader.Core;assembly=DungeonsModLoader.Core">
  <!--
    DataContext: InstalledViewModel.
    Header / toolbar (search + filter chips + bulk actions) / game-running banner / busy bar / mod list / footer.
    Rows are ModRowViewModel; row actions live on the page view model and receive the row as parameter.
  -->
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Views/Shell/PageStyles.xaml" />
      </ResourceDictionary.MergedDictionaries>

      <!-- 28px variants of the themed buttons for the toolbar and row actions. -->
      <Style x:Key="Installed.SmallButton" TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
        <Setter Property="Height" Value="{StaticResource Size.Control.HeightSmall}" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Small}" />
      </Style>

      <Style x:Key="Installed.SmallGhostButton" TargetType="Button" BasedOn="{StaticResource Button.Ghost}">
        <Setter Property="Height" Value="{StaticResource Size.Control.HeightSmall}" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Small}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}" />
      </Style>

      <Style x:Key="Installed.Chip" TargetType="RadioButton" BasedOn="{StaticResource Chip}">
        <Setter Property="Margin" Value="0,4,8,4" />
      </Style>

      <!--
        Row context menu (managed rows only). A ContextMenu is not in the visual tree, so the page view model is
        handed over through the row card's Tag and the row itself comes from PlacementTarget.DataContext.
      -->
      <ContextMenu x:Key="Installed.RowMenu" DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
        <MenuItem Header="Open on Nexus Mods"
                  Command="{Binding OpenOnNexusCommand}"
                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
          <MenuItem.Style>
            <!-- Only Nexus mods have a page to open; local mods do not get a permanently disabled item. -->
            <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
              <Style.Triggers>
                <DataTrigger Binding="{Binding PlacementTarget.DataContext.IsNexus, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Value="False">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </MenuItem.Style>
        </MenuItem>
        <MenuItem Header="Open folder"
                  Command="{Binding OpenFolderCommand}"
                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
        <MenuItem Header="Check for update"
                  Command="{Binding CheckForUpdateCommand}"
                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                  ToolTip="Available after Nexus Mods integration"
                  ToolTipService.ShowOnDisabled="True" />
        <MenuItem Header="Rename display name..."
                  Command="{Binding RenameCommand}"
                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
        <Separator />
        <MenuItem Header="Uninstall"
                  Command="{Binding UninstallCommand}"
                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
          <MenuItem.Style>
            <!-- Style setter (not a local value) so the template's disabled trigger can still grey it out. -->
            <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
              <Setter Property="Foreground" Value="{StaticResource Brush.Danger}" />
            </Style>
          </MenuItem.Style>
        </MenuItem>
      </ContextMenu>

      <Style x:Key="Installed.RowCard" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="Padding" Value="12" />
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="ContextMenu" Value="{StaticResource Installed.RowMenu}" />
        <Style.Triggers>
          <DataTrigger Binding="{Binding IsUnmanaged}" Value="True">
            <Setter Property="ContextMenu" Value="{x:Null}" />
          </DataTrigger>
          <Trigger Property="IsMouseOver" Value="True">
            <Setter Property="BorderBrush" Value="{StaticResource Brush.Border.Strong}" />
          </Trigger>
        </Style.Triggers>
      </Style>

      <!-- One mod row: thumbnail | name + badges / subtitle | toggle or action button. -->
      <DataTemplate x:Key="Installed.RowTemplate" DataType="{x:Type vm:ModRowViewModel}">
        <Border Style="{StaticResource Installed.RowCard}"
                Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Thumbnail placeholder (milestone 5 swaps in the Nexus image). -->
            <Border Grid.Column="0"
                    Width="48" Height="48"
                    Background="{StaticResource Brush.Bg.Input}"
                    BorderBrush="{StaticResource Brush.Border}"
                    BorderThickness="{StaticResource Thickness.Border.Thin}"
                    CornerRadius="{StaticResource Radius.Small}"
                    VerticalAlignment="Center">
              <Path Data="{StaticResource Icon.Pak}"
                    Width="22" Height="22"
                    Stretch="Uniform"
                    Fill="{StaticResource Brush.Text.Muted}"
                    SnapsToDevicePixels="True" />
            </Border>

            <StackPanel Grid.Column="1" Margin="14,0,14,0" VerticalAlignment="Center">
              <Grid HorizontalAlignment="Left">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Style="{StaticResource Text.H3}"
                           Text="{Binding DisplayName}"
                           VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                  <Border Style="{DynamicResource Badge.Cyan}" Margin="0,0,6,0"
                          Visibility="{Binding IsLocal, Converter={StaticResource Converter.BoolToVisibility}}">
                    <TextBlock Text="Local" />
                  </Border>
                  <Border Style="{DynamicResource Badge.Accent}" Margin="0,0,6,0"
                          Visibility="{Binding IsNexus, Converter={StaticResource Converter.BoolToVisibility}}">
                    <TextBlock Text="Nexus" />
                  </Border>
                  <Border Style="{DynamicResource Badge.Danger}" Margin="0,0,6,0"
                          Visibility="{Binding IsMissing, Converter={StaticResource Converter.BoolToVisibility}}">
                    <TextBlock Text="Missing" />
                  </Border>
                  <Border Style="{DynamicResource Badge.Warning}" Margin="0,0,6,0"
                          Visibility="{Binding IsUnmanaged, Converter={StaticResource Converter.BoolToVisibility}}">
                    <TextBlock Text="Unmanaged" />
                  </Border>
                </StackPanel>
              </Grid>
              <TextBlock Style="{StaticResource Text.Small}" Text="{Binding Subtitle}" Margin="0,3,0,0" />
            </StackPanel>

            <Grid Grid.Column="2" VerticalAlignment="Center" Margin="8,0,4,0">
              <ToggleButton Style="{DynamicResource ToggleSwitch}"
                            IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                            IsEnabled="{Binding CanToggle}"
                            Visibility="{Binding ShowToggle, Converter={StaticResource Converter.BoolToVisibility}}"
                            AutomationProperties.Name="{Binding DisplayName, StringFormat='Enable {0}'}" />
              <Button Style="{StaticResource Installed.SmallButton}"
                      Content="Import"
                      Visibility="{Binding IsUnmanaged, Converter={StaticResource Converter.BoolToVisibility}}"
                      Command="{Binding DataContext.ImportCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                      CommandParameter="{Binding}"
                      ToolTip="Add this folder to the mod list so it can be disabled, renamed or uninstalled" />
              <Button Style="{StaticResource Installed.SmallGhostButton}"
                      Content="Remove entry"
                      Visibility="{Binding IsMissing, Converter={StaticResource Converter.BoolToVisibility}}"
                      Command="{Binding DataContext.RemoveMissingCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                      CommandParameter="{Binding}" />
            </Grid>
          </Grid>
        </Border>
      </DataTemplate>
    </ResourceDictionary>
  </UserControl.Resources>

  <Grid Margin="{StaticResource Padding.Page}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- ============================ Header ============================ -->
    <StackPanel Grid.Row="0">
      <TextBlock Style="{StaticResource Text.H1}" Text="{Binding Title}" />
      <TextBlock Style="{StaticResource Page.Subtitle}">
        <Run Text="Mods installed in" /><Run Text=" " /><Run Text="{x:Static core:AppInfo.GameDisplayName}" /><Run Text=", with their enabled state." />
      </TextBlock>
    </StackPanel>

    <!-- ============================ Toolbar ============================ -->
    <!-- Search | filter chips (wrap when the window is narrow) | bulk actions. -->
    <Grid Grid.Row="1" Margin="0,20,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <TextBox Grid.Column="0"
               Style="{DynamicResource TextBox.Search}"
               Width="240"
               VerticalAlignment="Top"
               controls:TextBoxHelper.Placeholder="Search mods..."
               Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
               AutomationProperties.Name="Search mods" />

      <WrapPanel Grid.Column="1" Margin="16,0,16,0" VerticalAlignment="Top">
        <RadioButton Style="{StaticResource Installed.Chip}" GroupName="InstalledFilter" Content="All"
                     IsChecked="{Binding IsAllFilter, Mode=TwoWay}" />
        <RadioButton Style="{StaticResource Installed.Chip}" GroupName="InstalledFilter" Content="Enabled"
                     IsChecked="{Binding IsEnabledFilter, Mode=TwoWay}" />
        <RadioButton Style="{StaticResource Installed.Chip}" GroupName="InstalledFilter" Content="Disabled"
                     IsChecked="{Binding IsDisabledFilter, Mode=TwoWay}" />
        <RadioButton Style="{StaticResource Installed.Chip}" GroupName="InstalledFilter" Content="Updates available"
                     IsChecked="{Binding IsUpdatesFilter, Mode=TwoWay}" />
      </WrapPanel>

      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,4,0,0">
        <Button Style="{StaticResource Installed.SmallButton}" Content="Enable all" Command="{Binding EnableAllCommand}" Margin="0,0,8,0" />
        <Button Style="{StaticResource Installed.SmallButton}" Content="Disable all" Command="{Binding DisableAllCommand}" />
      </StackPanel>
    </Grid>

    <!-- ============================ Game-running banner ============================ -->
    <Border Grid.Row="2"
            Style="{DynamicResource Card}"
            Background="{StaticResource Brush.Warning.Faint}"
            Padding="12,10"
            Margin="0,16,0,0"
            Visibility="{Binding IsGameRunning, Converter={StaticResource Converter.BoolToVisibility}}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Style="{DynamicResource Badge.Warning}" Margin="0,0,12,0" VerticalAlignment="Center">
          <TextBlock Text="Game running" />
        </Border>
        <TextBlock Grid.Column="1" Style="{StaticResource Text.Body}" VerticalAlignment="Center">
          <Run Text="{x:Static core:AppInfo.GameDisplayName}" /><Run Text=" is running. Mod changes are locked until the game closes." />
        </TextBlock>
      </Grid>
    </Border>

    <!-- ============================ Busy bar ============================ -->
    <StackPanel Grid.Row="3" Margin="0,16,0,0"
                Visibility="{Binding IsBusy, Converter={StaticResource Converter.BoolToVisibility}}">
      <TextBlock Style="{StaticResource Text.Small}" Text="{Binding BusyText}" Margin="0,0,0,6" />
      <ProgressBar IsIndeterminate="True" />
    </StackPanel>

    <!-- ============================ List ============================ -->
    <Grid Grid.Row="4" Margin="0,16,0,0">
      <ScrollViewer VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled"
                    Visibility="{Binding HasAnyRows, Converter={StaticResource Converter.BoolToVisibility}}">
        <ItemsControl ItemsSource="{Binding VisibleRows}"
                      ItemTemplate="{StaticResource Installed.RowTemplate}"
                      Focusable="False" />
      </ScrollViewer>

      <!-- Mods exist, but the search / filter hides them all. -->
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420"
                  Visibility="{Binding ShowNoMatches, Converter={StaticResource Converter.BoolToVisibility}}">
        <TextBlock Style="{StaticResource EmptyState.Headline}" Text="No mods match" Margin="0,0,0,8" />
        <TextBlock Style="{StaticResource Text.Secondary}" Text="Try another search or pick a different filter." TextAlignment="Center" TextWrapping="Wrap" />
      </StackPanel>

      <!-- Nothing installed at all. -->
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420"
                  Visibility="{Binding ShowEmptyState, Converter={StaticResource Converter.BoolToVisibility}}">
        <Path Style="{StaticResource EmptyState.Icon}" Data="{StaticResource Icon.Installed}" />
        <TextBlock Style="{StaticResource EmptyState.Headline}" Text="No mods installed yet" />
        <Button Style="{DynamicResource Button.Primary}"
                Content="Browse Nexus Mods"
                HorizontalAlignment="Center"
                Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                CommandParameter="{Binding DataContext.Browse, RelativeSource={RelativeSource AncestorType=Window}}" />
      </StackPanel>
    </Grid>

    <!-- ============================ Footer ============================ -->
    <StackPanel Grid.Row="5">
      <Separator Style="{DynamicResource Divider}" Margin="0,8,0,10" />
      <TextBlock Style="{StaticResource Text.Small}" Text="{Binding FooterText}" />
    </StackPanel>
  </Grid>
</UserControl>
