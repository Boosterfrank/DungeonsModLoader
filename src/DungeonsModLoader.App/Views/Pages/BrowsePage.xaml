<UserControl x:Class="DungeonsModLoader.App.Views.Pages.BrowsePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:DungeonsModLoader.Core;assembly=DungeonsModLoader.Core">
  <!-- DataContext: BrowseViewModel. Nexus Mods browsing is coming soon. -->
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Views/Shell/PageStyles.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>

  <Grid Margin="{StaticResource Padding.Page}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0">
      <TextBlock Style="{StaticResource Text.H1}" Text="{Binding Title}" />
      <TextBlock Style="{StaticResource Page.Subtitle}">
        <Run Text="Discover mods for" /><Run Text=" " /><Run Text="{x:Static core:AppInfo.GameDisplayName}" /><Run Text=" on Nexus Mods." />
      </TextBlock>
    </StackPanel>

    <!-- Empty state -->
    <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420">
      <Path Style="{StaticResource EmptyState.Icon}" Data="{StaticResource Icon.Browse}" />
      <TextBlock Style="{StaticResource EmptyState.Headline}" Text="Nexus Mods browsing is coming soon" />

      <!-- Disabled search box look (static; the real TextBox.Search comes with the Browse feature). -->
      <Border Width="320"
              Height="{StaticResource Size.Control.Height}"
              Background="{StaticResource Brush.Bg.Input}"
              BorderBrush="{StaticResource Brush.Border}"
              BorderThickness="{StaticResource Thickness.Border.Thin}"
              CornerRadius="{StaticResource Radius.Medium}"
              Opacity="0.6"
              HorizontalAlignment="Center">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0">
          <Path Data="{StaticResource Icon.Search}"
                Width="14" Height="14"
                Stretch="Uniform"
                Fill="{StaticResource Brush.Text.Muted}"
                VerticalAlignment="Center" />
          <TextBlock Style="{StaticResource Text.Secondary}"
                     Foreground="{StaticResource Brush.Text.Muted}"
                     Text="Search Nexus Mods…"
                     VerticalAlignment="Center"
                     Margin="10,0,0,0" />
        </StackPanel>
      </Border>
    </StackPanel>
  </Grid>
</UserControl>
