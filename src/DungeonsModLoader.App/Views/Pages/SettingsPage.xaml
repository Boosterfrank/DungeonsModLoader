<UserControl x:Class="DungeonsModLoader.App.Views.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:DungeonsModLoader.Core;assembly=DungeonsModLoader.Core">
  <!-- DataContext: SettingsViewModel. Nexus account / nxm handler sections arrive in later milestones. -->
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Views/Shell/PageStyles.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>

  <Grid Margin="{StaticResource Padding.Page}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0">
      <TextBlock Style="{StaticResource Text.H1}" Text="{Binding Title}" />
      <TextBlock Style="{StaticResource Page.Subtitle}" Text="Game folder and app information. Nexus account options arrive in a later milestone." />
    </StackPanel>

    <ScrollViewer Grid.Row="1" Margin="0,24,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel>

        <!-- Game -->
        <Border Style="{DynamicResource Card}"
                Padding="{StaticResource Padding.Card}"
                MaxWidth="560"
                HorizontalAlignment="Left"
                Margin="0,0,0,16">
          <StackPanel>
            <TextBlock Style="{StaticResource Text.H2}" Text="Game" />

            <TextBlock Style="{StaticResource Text.Label}" Text="GAME FOLDER" Margin="0,16,0,6" />
            <StackPanel Orientation="Horizontal">
              <Border Style="{DynamicResource Badge.Cyan}" Margin="0,0,10,0"
                      Visibility="{Binding IsSteam, Converter={StaticResource Converter.BoolToVisibility}}">
                <TextBlock Text="Steam" />
              </Border>
              <Border Style="{DynamicResource Badge.Purple}" Margin="0,0,10,0"
                      Visibility="{Binding IsXbox, Converter={StaticResource Converter.BoolToVisibility}}">
                <TextBlock Text="Xbox app" />
              </Border>
              <Border Style="{DynamicResource Badge}" Margin="0,0,10,0"
                      Visibility="{Binding IsManual, Converter={StaticResource Converter.BoolToVisibility}}">
                <TextBlock Text="Manual" />
              </Border>
              <TextBlock Style="{StaticResource Text.Small}" Text="{Binding GameLaunchHint}" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Style="{StaticResource Text.Body}"
                       Text="{Binding GameRootDisplay}"
                       ToolTip="{Binding GameRootDisplay}"
                       TextTrimming="CharacterEllipsis"
                       TextWrapping="NoWrap"
                       Margin="0,8,0,0" />

            <WrapPanel Margin="0,16,0,-8">
              <Button Style="{DynamicResource Button.Secondary}" Content="Re-detect" Command="{Binding RedetectCommand}" Margin="0,0,8,8" />
              <Button Style="{DynamicResource Button.Secondary}" Content="Browse..." Command="{Binding BrowseCommand}" Margin="0,0,8,8" />
              <Button Style="{DynamicResource Button.Ghost}" Content="Open folder" Command="{Binding OpenGameFolderCommand}" Margin="0,0,8,8" />
            </WrapPanel>

            <TextBlock Style="{StaticResource Text.Small}"
                       Foreground="{StaticResource Brush.Success}"
                       Text="{Binding GameConfirmation}"
                       Margin="0,12,0,0"
                       Visibility="{Binding GameConfirmation, Converter={StaticResource Converter.NullToVisibility}}" />
          </StackPanel>
        </Border>

        <!-- About -->
        <Border Style="{DynamicResource Card}"
                Padding="{StaticResource Padding.Card}"
                MaxWidth="560"
                HorizontalAlignment="Left">
          <StackPanel>
            <TextBlock Style="{StaticResource Text.H2}" Text="About" />
            <TextBlock Style="{StaticResource Text.Body}" Margin="0,8,0,0">
              <Run Text="{x:Static core:AppInfo.DisplayName}" FontWeight="SemiBold" /><Run Text="  ·  " /><Run Text="Version" /><Run Text=" " /><Run Text="{Binding AppVersion, Mode=OneWay}" />
            </TextBlock>
            <TextBlock Style="{StaticResource Text.Secondary}" Margin="0,4,0,0">
              <Run Text="A mod manager for" /><Run Text=" " /><Run Text="{x:Static core:AppInfo.GameDisplayName}" /><Run Text="." />
            </TextBlock>
            <WrapPanel Margin="0,16,0,-8">
              <Button Style="{DynamicResource Button.Secondary}" Content="Open logs folder" Command="{Binding OpenLogsFolderCommand}" Margin="0,0,8,8" />
              <Button Style="{DynamicResource Button.Secondary}" Content="Open data folder" Command="{Binding OpenDataFolderCommand}" Margin="0,0,8,8" />
              <Button Style="{DynamicResource Button.Secondary}" Content="Theme swatches" Command="{Binding OpenSwatchesCommand}" Margin="0,0,8,8" />
            </WrapPanel>
          </StackPanel>
        </Border>

      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
