<UserControl x:Class="DungeonsModLoader.App.Views.Pages.ProfilesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- DataContext: ProfilesViewModel. Profiles arrive in milestone 4. -->
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Views/Shell/PageStyles.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>

  <Grid Margin="{StaticResource Padding.Page}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0">
      <TextBlock Style="{StaticResource Text.H1}" Text="{Binding Title}" />
      <TextBlock Style="{StaticResource Page.Subtitle}" Text="Named sets of enabled mods you can switch between." />
    </StackPanel>

    <!-- Empty state -->
    <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420">
      <Path Style="{StaticResource EmptyState.Icon}" Data="{StaticResource Icon.Profiles}" />
      <TextBlock Style="{StaticResource EmptyState.Headline}" Text="Profiles arrive in milestone 4" />
      <Button Style="{DynamicResource Button.Secondary}"
              Content="New profile"
              IsEnabled="False"
              HorizontalAlignment="Center"
              ToolTip="Available in milestone 4" />
    </StackPanel>
  </Grid>
</UserControl>
