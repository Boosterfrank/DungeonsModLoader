<Window x:Class="DungeonsModLoader.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:DungeonsModLoader.App.Views.Shell"
        xmlns:core="clr-namespace:DungeonsModLoader.Core;assembly=DungeonsModLoader.Core"
        xmlns:services="clr-namespace:DungeonsModLoader.App.Services"
        Title="{x:Static core:AppInfo.DisplayName}"
        Width="1200" Height="760" MinWidth="1000" MinHeight="650"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow"
        AllowsTransparency="False"
        ResizeMode="CanResize"
        Background="{StaticResource Brush.Window.Background}"
        FontFamily="{StaticResource Font.Body}"
        FontSize="{StaticResource FontSize.Body}"
        Foreground="{StaticResource Brush.Text.Primary}"
        Typography.StandardLigatures="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

  <!--
    Custom chrome: the whole window is client area; our 40px title bar is the caption (drag / double-click to
    maximize come from WindowChrome). The caption buttons are the only hit-test-visible elements in it.
    WindowChromeHelper (code-behind) keeps the maximized content inside the monitor's work area, owns hit testing
    while maximized and adds Windows 11 snap layouts on the maximize button.
  -->
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="{StaticResource Size.TitleBar.Height}"
                  ResizeBorderThickness="6"
                  GlassFrameThickness="0"
                  CornerRadius="0"
                  UseAeroCaptionButtons="False"
                  NonClientFrameEdges="None" />
  </WindowChrome.WindowChrome>

  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Shell/ShellStyles.xaml" />
        <ResourceDictionary Source="Shell/PageTemplates.xaml" />
      </ResourceDictionary.MergedDictionaries>

      <!-- Play button: disabled (muted by the template) while the process monitor reports the game as running. -->
      <Style x:Key="Shell.PlayButton" TargetType="Button" BasedOn="{StaticResource Button.Play}">
        <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
        <Style.Triggers>
          <DataTrigger Binding="{Binding IsGameRunning}" Value="True">
            <Setter Property="IsEnabled" Value="False" />
            <Setter Property="ToolTip" Value="The game is running" />
          </DataTrigger>
        </Style.Triggers>
      </Style>

      <!-- "PLAY" normally, "RUNNING" while the game is up. -->
      <Style x:Key="Shell.PlayLabel" TargetType="TextBlock">
        <Setter Property="Text" Value="PLAY" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Style.Triggers>
          <DataTrigger Binding="{Binding IsGameRunning}" Value="True">
            <Setter Property="Text" Value="RUNNING" />
          </DataTrigger>
        </Style.Triggers>
      </Style>

      <!-- ============================ Toasts ============================ -->
      <!-- Accent bar on the left edge of a toast, coloured by kind. -->
      <Style x:Key="Shell.ToastBar" TargetType="Border">
        <Setter Property="Width" Value="4" />
        <Setter Property="CornerRadius" Value="4,0,0,4" />
        <Setter Property="Background" Value="{StaticResource Brush.Cyan}" />
        <Style.Triggers>
          <DataTrigger Binding="{Binding IsSuccess}" Value="True">
            <Setter Property="Background" Value="{StaticResource Brush.Success}" />
          </DataTrigger>
          <DataTrigger Binding="{Binding IsWarning}" Value="True">
            <Setter Property="Background" Value="{StaticResource Brush.Warning}" />
          </DataTrigger>
          <DataTrigger Binding="{Binding IsError}" Value="True">
            <Setter Property="Background" Value="{StaticResource Brush.Danger}" />
          </DataTrigger>
        </Style.Triggers>
      </Style>

      <Style x:Key="Shell.ToastAction" TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
        <Setter Property="Height" Value="{StaticResource Size.Control.HeightSmall}" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Small}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Margin" Value="0,10,0,0" />
      </Style>

      <!-- One toast: elevated card, accent bar, optional title, message, optional action, dismiss X. Fades and slides in. -->
      <DataTemplate x:Key="Shell.ToastTemplate" DataType="{x:Type services:ToastViewModel}">
        <Border Width="380" Margin="0,8,0,0" Padding="0" Style="{DynamicResource Card.Elevated}" Opacity="0">
          <Border.RenderTransform>
            <TranslateTransform Y="12" />
          </Border.RenderTransform>
          <Border.Triggers>
            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
              <BeginStoryboard>
                <Storyboard>
                  <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource Duration.Normal}" />
                  <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="0" Duration="{StaticResource Duration.Normal}">
                    <DoubleAnimation.EasingFunction>
                      <QuadraticEase EasingMode="EaseOut" />
                    </DoubleAnimation.EasingFunction>
                  </DoubleAnimation>
                </Storyboard>
              </BeginStoryboard>
            </EventTrigger>
          </Border.Triggers>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource Shell.ToastBar}" />
            <StackPanel Grid.Column="1" Margin="14,12,6,12">
              <TextBlock Style="{StaticResource Text.Body}" FontWeight="SemiBold" Text="{Binding Title}" TextWrapping="Wrap" Margin="0,0,0,3"
                         Visibility="{Binding HasTitle, Converter={StaticResource Converter.BoolToVisibility}}" />
              <TextBlock Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Text.Secondary}" Text="{Binding Message}" TextWrapping="Wrap" />
              <Button Style="{StaticResource Shell.ToastAction}" Content="{Binding ActionText}" Command="{Binding RunActionCommand}"
                      Visibility="{Binding HasAction, Converter={StaticResource Converter.BoolToVisibility}}" />
            </StackPanel>
            <Button Grid.Column="2" Style="{DynamicResource Button.Icon}" Width="28" Height="28" Margin="0,8,8,0" VerticalAlignment="Top"
                    Command="{Binding DismissCommand}" ToolTip="Dismiss" AutomationProperties.Name="Dismiss notification">
              <Path Data="{StaticResource Glyph.Close}" Width="9" Height="9" Stretch="Uniform"
                    Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
            </Button>
          </Grid>
        </Border>
      </DataTemplate>
    </ResourceDictionary>
  </Window.Resources>

  <Window.InputBindings>
    <KeyBinding Modifiers="Ctrl" Key="D1" Command="{Binding NavigateCommand}" CommandParameter="{Binding Installed}" />
    <KeyBinding Modifiers="Ctrl" Key="D2" Command="{Binding NavigateCommand}" CommandParameter="{Binding Browse}" />
    <KeyBinding Modifiers="Ctrl" Key="D3" Command="{Binding NavigateCommand}" CommandParameter="{Binding Profiles}" />
    <KeyBinding Modifiers="Ctrl" Key="D4" Command="{Binding NavigateCommand}" CommandParameter="{Binding Settings}" />
  </Window.InputBindings>

  <!--
    Drag & drop install: the root grid is the drop target. The tunnelling (Preview*) events are used so the feedback
    is consistent even over controls that handle drag events themselves (the search TextBox); see code-behind.
  -->
  <Grid AllowDrop="True"
        PreviewDragEnter="OnPreviewDragEnter"
        PreviewDragOver="OnPreviewDragOver"
        PreviewDragLeave="OnPreviewDragLeave"
        PreviewDrop="OnPreviewDrop">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- ============================ Title bar ============================ -->
    <Grid Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
          Height="{StaticResource Size.TitleBar.Height}"
          Background="{StaticResource Brush.Bg.Deepest}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <TextBlock Grid.Column="0"
                 Style="{StaticResource Text.Small}"
                 Foreground="{StaticResource Brush.Text.Muted}"
                 Text="{x:Static core:AppInfo.DisplayName}"
                 VerticalAlignment="Center"
                 Margin="16,0,0,0" />

      <!-- Transient status (e.g. the Play stub); hidden while empty. -->
      <TextBlock Grid.Column="1"
                 Text="{Binding StatusText}"
                 HorizontalAlignment="Center" VerticalAlignment="Center"
                 Margin="16,0">
        <TextBlock.Style>
          <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Small}">
            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Muted}" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding StatusText}" Value="">
                <Setter Property="Visibility" Value="Collapsed" />
              </DataTrigger>
              <DataTrigger Binding="{Binding StatusText}" Value="{x:Null}">
                <Setter Property="Visibility" Value="Collapsed" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </TextBlock.Style>
      </TextBlock>

      <StackPanel Grid.Column="2" Orientation="Horizontal">
        <Button Style="{StaticResource CaptionButton.Minimize}"
                Click="OnMinimizeClick"
                AutomationProperties.Name="Minimize" />
        <Button x:Name="MaximizeButton"
                Style="{StaticResource CaptionButton.Maximize}"
                Click="OnMaximizeRestoreClick"
                AutomationProperties.Name="Maximize" />
        <Button Style="{StaticResource CaptionButton.Close}"
                Click="OnCloseClick"
                AutomationProperties.Name="Close" />
      </StackPanel>
    </Grid>

    <!-- ============================ Sidebar ============================ -->
    <Border Grid.Row="1" Grid.Column="0"
            Width="{StaticResource Size.Sidebar.Width}"
            Background="{StaticResource Brush.Sidebar.Background}"
            BorderBrush="{StaticResource Brush.Border.Subtle}"
            BorderThickness="0,0,1,0">
      <DockPanel LastChildFill="True">

        <!-- Bottom: the one primary action, always visible -->
        <StackPanel DockPanel.Dock="Bottom" Margin="16,16,16,16">
          <Button Style="{StaticResource Shell.PlayButton}"
                  Command="{Binding PlayCommand}"
                  HorizontalAlignment="Stretch"
                  AutomationProperties.Name="Play">
            <StackPanel Orientation="Horizontal">
              <Path Data="{StaticResource Icon.Play}"
                    Width="10" Height="12"
                    Stretch="Uniform"
                    Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                    VerticalAlignment="Center"
                    Margin="0,0,10,0" />
              <TextBlock Style="{StaticResource Shell.PlayLabel}" />
            </StackPanel>
          </Button>
          <TextBlock Style="{StaticResource Text.Caption}"
                     HorizontalAlignment="Center"
                     Margin="0,8,0,0"><Run Text="{x:Static core:AppInfo.GameDisplayName}" /><Run Text="  ·  " /><Run Text="{Binding GameSourceLabel, Mode=OneWay}" /></TextBlock>
        </StackPanel>

        <!-- Top: logo + navigation -->
        <StackPanel>
          <Image Source="pack://application:,,,/Assets/Images/Logo.png"
                 Width="180"
                 Stretch="Uniform"
                 RenderOptions.BitmapScalingMode="HighQuality"
                 Margin="16,24,16,0" />
          <TextBlock Text="MOD LOADER"
                     FontFamily="{StaticResource Font.Display}"
                     FontWeight="SemiBold"
                     FontSize="13"
                     Foreground="{StaticResource Brush.Accent.Light}"
                     HorizontalAlignment="Center"
                     Margin="0,4,0,24" />

          <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" Content="Installed"
                       shell:NavItem.Icon="{StaticResource Icon.Installed}"
                       Command="{Binding NavigateCommand}" CommandParameter="{Binding Installed}"
                       ToolTip="Installed (Ctrl+1)">
            <RadioButton.IsChecked>
              <MultiBinding Converter="{StaticResource ReferenceEqualityConverter}" Mode="OneWay">
                <Binding Path="CurrentPage" />
                <Binding Path="Installed" />
              </MultiBinding>
            </RadioButton.IsChecked>
          </RadioButton>

          <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" Content="Browse"
                       shell:NavItem.Icon="{StaticResource Icon.Browse}"
                       Command="{Binding NavigateCommand}" CommandParameter="{Binding Browse}"
                       ToolTip="Browse (Ctrl+2)">
            <RadioButton.IsChecked>
              <MultiBinding Converter="{StaticResource ReferenceEqualityConverter}" Mode="OneWay">
                <Binding Path="CurrentPage" />
                <Binding Path="Browse" />
              </MultiBinding>
            </RadioButton.IsChecked>
          </RadioButton>

          <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" Content="Profiles"
                       shell:NavItem.Icon="{StaticResource Icon.Profiles}"
                       Command="{Binding NavigateCommand}" CommandParameter="{Binding Profiles}"
                       ToolTip="Profiles (Ctrl+3)">
            <RadioButton.IsChecked>
              <MultiBinding Converter="{StaticResource ReferenceEqualityConverter}" Mode="OneWay">
                <Binding Path="CurrentPage" />
                <Binding Path="Profiles" />
              </MultiBinding>
            </RadioButton.IsChecked>
          </RadioButton>

          <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" Content="Settings"
                       shell:NavItem.Icon="{StaticResource Icon.Settings}"
                       Command="{Binding NavigateCommand}" CommandParameter="{Binding Settings}"
                       ToolTip="Settings (Ctrl+4)">
            <RadioButton.IsChecked>
              <MultiBinding Converter="{StaticResource ReferenceEqualityConverter}" Mode="OneWay">
                <Binding Path="CurrentPage" />
                <Binding Path="Settings" />
              </MultiBinding>
            </RadioButton.IsChecked>
          </RadioButton>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- ============================ Content ============================ -->
    <shell:TransitioningContentControl Grid.Row="1" Grid.Column="1"
                                       Content="{Binding CurrentPage}" />

    <!-- ============================ Toasts (bottom-right) ============================ -->
    <ItemsControl Grid.Row="1" Grid.Column="1"
                  ItemsSource="{Binding Toasts}"
                  ItemTemplate="{StaticResource Shell.ToastTemplate}"
                  HorizontalAlignment="Right" VerticalAlignment="Bottom"
                  Margin="0,0,24,24"
                  Focusable="False" IsTabStop="False"
                  AutomationProperties.Name="Notifications" />

    <!-- ============================ Drop overlay ============================ -->
    <!-- Shown while acceptable files are dragged over the window; not hit-test visible so the grid stays the drop target. -->
    <Border x:Name="DropOverlay"
            Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
            Background="{StaticResource Brush.Bg.Overlay}"
            Visibility="Collapsed"
            IsHitTestVisible="False">
      <Grid Width="440" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Rectangle Fill="{StaticResource Brush.Bg.Panel}"
                   Stroke="{StaticResource Brush.Accent}"
                   StrokeThickness="2"
                   StrokeDashArray="4 3"
                   RadiusX="4" RadiusY="4"
                   SnapsToDevicePixels="True" />
        <StackPanel Margin="32,36">
          <Path Data="{StaticResource Icon.Drop}"
                Width="32" Height="32"
                Stretch="Uniform"
                Fill="{StaticResource Brush.Accent.Light}"
                HorizontalAlignment="Center"
                SnapsToDevicePixels="True" />
          <TextBlock Style="{StaticResource Text.H2}"
                     Text="Drop to install"
                     HorizontalAlignment="Center"
                     Margin="0,16,0,6" />
          <TextBlock Style="{StaticResource Text.Secondary}"
                     Text="Archives (.zip, .7z, .rar) or .pak/.ucas/.utoc files"
                     HorizontalAlignment="Center"
                     TextAlignment="Center"
                     TextWrapping="Wrap" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
