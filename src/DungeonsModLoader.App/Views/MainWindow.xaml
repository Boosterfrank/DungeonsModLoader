<Window x:Class="DungeonsModLoader.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:DungeonsModLoader.App.Views.Shell"
        xmlns:core="clr-namespace:DungeonsModLoader.Core;assembly=DungeonsModLoader.Core"
        xmlns:services="clr-namespace:DungeonsModLoader.App.Services"
        Title="{x:Static core:AppInfo.DisplayName}"
        Width="1200" Height="760" MinWidth="1000" MinHeight="650"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow"
        AllowsTransparency="False"
        ResizeMode="CanResize"
        Background="{StaticResource Brush.Window.Background}"
        FontFamily="{StaticResource Font.Body}"
        FontSize="{StaticResource FontSize.Body}"
        Foreground="{StaticResource Brush.Text.Primary}"
        Typography.StandardLigatures="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

  <!--
    Custom chrome: the whole window is client area; our 40px title bar is the caption (drag / double-click to
    maximize come from WindowChrome). The caption buttons are the only hit-test-visible elements in it.
    WindowChromeHelper (code-behind) keeps the maximized content inside the monitor's work area, owns hit testing
    while maximized and adds Windows 11 snap layouts on the maximize button.
  -->
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="{StaticResource Size.TitleBar.Height}"
                  ResizeBorderThickness="6"
                  GlassFrameThickness="0"
                  CornerRadius="0"
                  UseAeroCaptionButtons="False"
                  NonClientFrameEdges="None" />
  </WindowChrome.WindowChrome>

  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Shell/ShellStyles.xaml" />
        <ResourceDictionary Source="Shell/PageTemplates.xaml" />
      </ResourceDictionary.MergedDictionaries>

      <!-- Play button: disabled (muted by the template) while the process monitor reports the game as running. -->
      <Style x:Key="Shell.PlayButton" TargetType="Button" BasedOn="{StaticResource Button.Play}">
        <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
        <Style.Triggers>
          <DataTrigger Binding="{Binding IsGameRunning}" Value="True">
            <Setter Property="IsEnabled" Value="False" />
            <Setter Property="ToolTip" Value="The game is running" />
          </DataTrigger>
        </Style.Triggers>
      </Style>

      <!-- "PLAY" normally, "RUNNING" while the game is up. -->
      <Style x:Key="Shell.PlayLabel" TargetType="TextBlock">
        <Setter Property="Text" Value="PLAY" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Style.Triggers>
          <DataTrigger Binding="{Binding IsGameRunning}" Value="True">
            <Setter Property="Text" Value="RUNNING" />
          </DataTrigger>
        </Style.Triggers>
      </Style>

      <!-- ============================ Picture viewer ============================ -->
      <Geometry x:Key="Shell.Glyph.ChevronLeft">M7,0 L9,2 L3.5,7.5 L9,13 L7,15 L0,7.5 Z</Geometry>
      <Geometry x:Key="Shell.Glyph.ChevronRight">M2,0 L0,2 L5.5,7.5 L0,13 L2,15 L9,7.5 Z</Geometry>

      <Style x:Key="Shell.ViewerButton" TargetType="Button" BasedOn="{StaticResource Button.Icon}">
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="44" />
        <Setter Property="MinWidth" Value="44" />
        <Setter Property="Background" Value="#66101A26" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
      </Style>

      <!-- ============================ Toasts ============================ -->
      <!-- Accent bar on the left edge of a toast, coloured by kind. -->
      <Style x:Key="Shell.ToastBar" TargetType="Border">
        <Setter Property="Width" Value="4" />
        <Setter Property="CornerRadius" Value="4,0,0,4" />
        <Setter Property="Background" Value="{StaticResource Brush.Cyan}" />
        <Style.Triggers>
          <DataTrigger Binding="{Binding IsSuccess}" Value="True">
            <Setter Property="Background" Value="{StaticResource Brush.Success}" />
          </DataTrigger>
          <DataTrigger Binding="{Binding IsWarning}" Value="True">
            <Setter Property="Background" Value="{StaticResource Brush.Warning}" />
          </DataTrigger>
          <DataTrigger Binding="{Binding IsError}" Value="True">
            <Setter Property="Background" Value="{StaticResource Brush.Danger}" />
          </DataTrigger>
        </Style.Triggers>
      </Style>

      <!-- Small buttons of the app update banner -->
      <Style x:Key="Shell.BannerButton" TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
        <Setter Property="Height" Value="{StaticResource Size.Control.HeightSmall}" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Small}" />
      </Style>

      <Style x:Key="Shell.BannerPrimaryButton" TargetType="Button" BasedOn="{StaticResource Button.Primary}">
        <Setter Property="Height" Value="{StaticResource Size.Control.HeightSmall}" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Small}" />
      </Style>

      <Style x:Key="Shell.ToastAction" TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
        <Setter Property="Height" Value="{StaticResource Size.Control.HeightSmall}" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Small}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Margin" Value="0,10,0,0" />
      </Style>

      <!-- One toast: elevated card, accent bar, optional title, message, optional action, dismiss X. Fades and slides in. -->
      <DataTemplate x:Key="Shell.ToastTemplate" DataType="{x:Type services:ToastViewModel}">
        <Border Width="380" Margin="0,8,0,0" Padding="0" Style="{DynamicResource Card.Elevated}" Opacity="0">
          <Border.RenderTransform>
            <TranslateTransform Y="12" />
          </Border.RenderTransform>
          <Border.Triggers>
            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
              <BeginStoryboard>
                <Storyboard>
                  <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource Duration.Normal}" />
                  <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="0" Duration="{StaticResource Duration.Normal}">
                    <DoubleAnimation.EasingFunction>
                      <QuadraticEase EasingMode="EaseOut" />
                    </DoubleAnimation.EasingFunction>
                  </DoubleAnimation>
                </Storyboard>
              </BeginStoryboard>
            </EventTrigger>
          </Border.Triggers>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource Shell.ToastBar}" />
            <StackPanel Grid.Column="1" Margin="14,12,6,12">
              <TextBlock Style="{StaticResource Text.Body}" FontWeight="SemiBold" Text="{Binding Title}" TextWrapping="Wrap" Margin="0,0,0,3"
                         Visibility="{Binding HasTitle, Converter={StaticResource Converter.BoolToVisibility}}" />
              <TextBlock Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Text.Secondary}" Text="{Binding Message}" TextWrapping="Wrap" />
              <Button Style="{StaticResource Shell.ToastAction}" Content="{Binding ActionText}" Command="{Binding RunActionCommand}"
                      Visibility="{Binding HasAction, Converter={StaticResource Converter.BoolToVisibility}}" />
            </StackPanel>
            <Button Grid.Column="2" Style="{DynamicResource Button.Icon}" Width="28" Height="28" Margin="0,8,8,0" VerticalAlignment="Top"
                    Command="{Binding DismissCommand}" ToolTip="Dismiss" AutomationProperties.Name="Dismiss notification">
              <Path Data="{StaticResource Glyph.Close}" Width="9" Height="9" Stretch="Uniform"
                    Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
            </Button>
          </Grid>
        </Border>
      </DataTemplate>
    </ResourceDictionary>
  </Window.Resources>

  <Window.InputBindings>
    <KeyBinding Modifiers="Ctrl" Key="D1" Command="{Binding NavigateCommand}" CommandParameter="{Binding Installed}" />
    <KeyBinding Modifiers="Ctrl" Key="D2" Command="{Binding NavigateCommand}" CommandParameter="{Binding Browse}" />
    <KeyBinding Modifiers="Ctrl" Key="D3" Command="{Binding NavigateCommand}" CommandParameter="{Binding Profiles}" />
    <KeyBinding Modifiers="Ctrl" Key="D4" Command="{Binding NavigateCommand}" CommandParameter="{Binding Settings}" />
  </Window.InputBindings>

  <!--
    Drag & drop install: the root grid is the drop target. The tunnelling (Preview*) events are used so the feedback
    is consistent even over controls that handle drag events themselves (the search TextBox); see code-behind.
  -->
  <Grid AllowDrop="True"
        PreviewDragEnter="OnPreviewDragEnter"
        PreviewDragOver="OnPreviewDragOver"
        PreviewDragLeave="OnPreviewDragLeave"
        PreviewDrop="OnPreviewDrop">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- ============================ Title bar ============================ -->
    <Grid Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
          Height="{StaticResource Size.TitleBar.Height}"
          Background="{StaticResource Brush.Bg.Deepest}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <TextBlock Grid.Column="0"
                 Style="{StaticResource Text.Small}"
                 Foreground="{StaticResource Brush.Text.Muted}"
                 Text="{x:Static core:AppInfo.DisplayName}"
                 VerticalAlignment="Center"
                 Margin="16,0,0,0" />

      <!-- Transient status (e.g. the Play stub); hidden while empty. -->
      <TextBlock Grid.Column="1"
                 Text="{Binding StatusText}"
                 HorizontalAlignment="Center" VerticalAlignment="Center"
                 Margin="16,0">
        <TextBlock.Style>
          <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Small}">
            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Muted}" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding StatusText}" Value="">
                <Setter Property="Visibility" Value="Collapsed" />
              </DataTrigger>
              <DataTrigger Binding="{Binding StatusText}" Value="{x:Null}">
                <Setter Property="Visibility" Value="Collapsed" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </TextBlock.Style>
      </TextBlock>

      <StackPanel Grid.Column="2" Orientation="Horizontal">
        <Button Style="{StaticResource CaptionButton.Minimize}"
                Click="OnMinimizeClick"
                AutomationProperties.Name="Minimize" />
        <Button x:Name="MaximizeButton"
                Style="{StaticResource CaptionButton.Maximize}"
                Click="OnMaximizeRestoreClick"
                AutomationProperties.Name="Maximize" />
        <Button Style="{StaticResource CaptionButton.Close}"
                Click="OnCloseClick"
                AutomationProperties.Name="Close" />
      </StackPanel>
    </Grid>

    <!-- ============================ Sidebar ============================ -->
    <Border Grid.Row="1" Grid.Column="0"
            Width="{StaticResource Size.Sidebar.Width}"
            Background="{StaticResource Brush.Sidebar.Background}"
            BorderBrush="{StaticResource Brush.Border.Subtle}"
            BorderThickness="0,0,1,0">
      <DockPanel LastChildFill="True">

        <!-- Bottom: the one primary action, always visible -->
        <StackPanel DockPanel.Dock="Bottom" Margin="16,16,16,16">
          <Button Style="{StaticResource Shell.PlayButton}"
                  Command="{Binding PlayCommand}"
                  HorizontalAlignment="Stretch"
                  AutomationProperties.Name="Play">
            <StackPanel Orientation="Horizontal">
              <Path Data="{StaticResource Icon.Play}"
                    Width="10" Height="12"
                    Stretch="Uniform"
                    Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                    VerticalAlignment="Center"
                    Margin="0,0,10,0" />
              <TextBlock Style="{StaticResource Shell.PlayLabel}" />
            </StackPanel>
          </Button>
          <TextBlock Style="{StaticResource Text.Caption}"
                     HorizontalAlignment="Center"
                     Margin="0,8,0,0"><Run Text="{x:Static core:AppInfo.GameDisplayName}" /><Run Text="  ·  " /><Run Text="{Binding GameSourceLabel, Mode=OneWay}" /></TextBlock>
        </StackPanel>

        <!-- Top: logo + navigation -->
        <StackPanel>
          <Image Source="pack://application:,,,/Assets/Images/Logo.png"
                 Width="180"
                 Stretch="Uniform"
                 RenderOptions.BitmapScalingMode="HighQuality"
                 Margin="16,24,16,0" />
          <TextBlock Text="MOD LOADER"
                     FontFamily="{StaticResource Font.Display}"
                     FontWeight="SemiBold"
                     FontSize="13"
                     Foreground="{StaticResource Brush.Accent.Light}"
                     HorizontalAlignment="Center"
                     Margin="0,4,0,24" />

          <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" Content="Installed"
                       shell:NavItem.Icon="{StaticResource Icon.Installed}"
                       Command="{Binding NavigateCommand}" CommandParameter="{Binding Installed}"
                       ToolTip="Installed (Ctrl+1)">
            <RadioButton.IsChecked>
              <MultiBinding Converter="{StaticResource ReferenceEqualityConverter}" Mode="OneWay">
                <Binding Path="CurrentPage" />
                <Binding Path="Installed" />
              </MultiBinding>
            </RadioButton.IsChecked>
          </RadioButton>

          <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" Content="Browse"
                       shell:NavItem.Icon="{StaticResource Icon.Browse}"
                       Command="{Binding NavigateCommand}" CommandParameter="{Binding Browse}"
                       ToolTip="Browse (Ctrl+2)">
            <RadioButton.IsChecked>
              <MultiBinding Converter="{StaticResource ReferenceEqualityConverter}" Mode="OneWay">
                <Binding Path="CurrentPage" />
                <Binding Path="Browse" />
              </MultiBinding>
            </RadioButton.IsChecked>
          </RadioButton>

          <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" Content="Profiles"
                       shell:NavItem.Icon="{StaticResource Icon.Profiles}"
                       Command="{Binding NavigateCommand}" CommandParameter="{Binding Profiles}"
                       ToolTip="Profiles (Ctrl+3)">
            <RadioButton.IsChecked>
              <MultiBinding Converter="{StaticResource ReferenceEqualityConverter}" Mode="OneWay">
                <Binding Path="CurrentPage" />
                <Binding Path="Profiles" />
              </MultiBinding>
            </RadioButton.IsChecked>
          </RadioButton>

          <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" Content="Settings"
                       shell:NavItem.Icon="{StaticResource Icon.Settings}"
                       Command="{Binding NavigateCommand}" CommandParameter="{Binding Settings}"
                       ToolTip="Settings (Ctrl+4)">
            <RadioButton.IsChecked>
              <MultiBinding Converter="{StaticResource ReferenceEqualityConverter}" Mode="OneWay">
                <Binding Path="CurrentPage" />
                <Binding Path="Settings" />
              </MultiBinding>
            </RadioButton.IsChecked>
          </RadioButton>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- ============================ Content ============================ -->
    <Grid Grid.Row="1" Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <!-- App update banner (non-blocking): shown when a newer GitHub release is known. -->
      <Border Grid.Row="0"
              Background="{StaticResource Brush.Accent.Faint}"
              BorderBrush="{StaticResource Brush.Accent.Dark}"
              BorderThickness="0,0,0,1"
              Padding="32,10"
              Visibility="{Binding ShowUpdateBanner, Converter={StaticResource Converter.BoolToVisibility}}"
              AutomationProperties.Name="Update banner">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Style="{StaticResource Text.Body}" Text="{Binding UpdateBannerText}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,16,0" />
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <Button Style="{StaticResource Shell.BannerButton}" Content="What's new" Command="{Binding OpenReleaseNotesCommand}" Margin="0,0,8,0" />
            <Button Style="{StaticResource Shell.BannerPrimaryButton}" Content="Update now" Command="{Binding InstallAppUpdateCommand}" Margin="0,0,8,0"
                    ToolTip="Downloads the new installer and runs it; the app closes and comes back updated" />
            <Button Style="{DynamicResource Button.Icon}" Width="28" Height="28" Command="{Binding DismissUpdateCommand}" ToolTip="Not now" AutomationProperties.Name="Dismiss update banner">
              <Path Data="{StaticResource Glyph.Close}" Width="9" Height="9" Stretch="Uniform"
                    Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <shell:TransitioningContentControl Grid.Row="1" Content="{Binding CurrentPage}" />
    </Grid>

    <!-- ============================ Toasts (bottom-right) ============================ -->
    <ItemsControl Grid.Row="1" Grid.Column="1"
                  ItemsSource="{Binding Toasts}"
                  ItemTemplate="{StaticResource Shell.ToastTemplate}"
                  HorizontalAlignment="Right" VerticalAlignment="Bottom"
                  Margin="0,0,24,24"
                  Focusable="False" IsTabStop="False"
                  AutomationProperties.Name="Notifications" />

    <!-- ============================ Picture viewer (lightbox) ============================ -->
    <!-- Covers everything below the title bar. Esc / Left / Right work while it has focus (it takes focus when it opens). -->
    <Border x:Name="PreviewOverlay"
            Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
            Background="#F0060B10"
            Focusable="True" FocusVisualStyle="{x:Null}"
            MouseLeftButtonDown="OnPreviewBackdropMouseDown"
            Visibility="{Binding Preview.IsOpen, Converter={StaticResource Converter.BoolToVisibility}}"
            AutomationProperties.Name="Picture viewer">
      <Border.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding Preview.CloseCommand}" />
        <KeyBinding Key="Left" Command="{Binding Preview.PreviousCommand}" />
        <KeyBinding Key="Right" Command="{Binding Preview.NextCommand}" />
      </Border.InputBindings>
      <Grid x:Name="PreviewBackdrop" Background="Transparent" Margin="24,16,24,20">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: title, counter, open in browser, close -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Style="{StaticResource Text.H3}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
            <Run Text="{Binding Preview.Title, Mode=OneWay}" /><Run Text="   " /><Run Text="{Binding Preview.CounterText, Mode=OneWay}" Foreground="{StaticResource Brush.Text.Secondary}" />
          </TextBlock>
          <Button Grid.Column="1" Style="{StaticResource Shell.BannerButton}" Content="Open in browser" Command="{Binding Preview.OpenInBrowserCommand}" Margin="0,0,10,0" VerticalAlignment="Center" />
          <Button Grid.Column="2" Style="{StaticResource Shell.ViewerButton}" Command="{Binding Preview.CloseCommand}" ToolTip="Close (Esc)" AutomationProperties.Name="Close picture viewer">
            <Path Data="{StaticResource Glyph.Close}" Width="12" Height="12" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
          </Button>
        </Grid>

        <!-- Picture -->
        <Grid Grid.Row="1">
          <Image Source="{Binding Preview.CurrentPath, Converter={StaticResource Converter.FileToImage}, ConverterParameter=2200}"
                 Stretch="Uniform" StretchDirection="DownOnly"
                 RenderOptions.BitmapScalingMode="HighQuality"
                 HorizontalAlignment="Center" VerticalAlignment="Center" />
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="240"
                      Visibility="{Binding Preview.IsLoading, Converter={StaticResource Converter.BoolToVisibility}}">
            <TextBlock Style="{StaticResource Text.Secondary}" Text="Loading picture..." TextAlignment="Center" Margin="0,0,0,10" />
            <ProgressBar IsIndeterminate="True" />
          </StackPanel>
          <TextBlock Style="{StaticResource Text.Secondary}" Text="{Binding Preview.ErrorText}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="420"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     Visibility="{Binding Preview.ErrorText, Converter={StaticResource Converter.NullToVisibility}}" />

          <Button Style="{StaticResource Shell.ViewerButton}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="4,0,0,0"
                  Command="{Binding Preview.PreviousCommand}" ToolTip="Previous (Left arrow)" AutomationProperties.Name="Previous picture"
                  Visibility="{Binding Preview.HasMany, Converter={StaticResource Converter.BoolToVisibility}}">
            <Path Data="{StaticResource Shell.Glyph.ChevronLeft}" Width="9" Height="15" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
          </Button>
          <Button Style="{StaticResource Shell.ViewerButton}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0"
                  Command="{Binding Preview.NextCommand}" ToolTip="Next (Right arrow)" AutomationProperties.Name="Next picture"
                  Visibility="{Binding Preview.HasMany, Converter={StaticResource Converter.BoolToVisibility}}">
            <Path Data="{StaticResource Shell.Glyph.ChevronRight}" Width="9" Height="15" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
          </Button>
        </Grid>

        <TextBlock Grid.Row="2" Style="{StaticResource Text.Caption}" HorizontalAlignment="Center" Margin="0,12,0,0"
                   Text="Click outside the picture or press Esc to close · Left / Right arrows to browse" />
      </Grid>
    </Border>

    <!-- ============================ Drop overlay ============================ -->
    <!-- Shown while acceptable files are dragged over the window; not hit-test visible so the grid stays the drop target. -->
    <Border x:Name="DropOverlay"
            Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
            Background="{StaticResource Brush.Bg.Overlay}"
            Visibility="Collapsed"
            IsHitTestVisible="False">
      <Grid Width="440" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Rectangle Fill="{StaticResource Brush.Bg.Panel}"
                   Stroke="{StaticResource Brush.Accent}"
                   StrokeThickness="2"
                   StrokeDashArray="4 3"
                   RadiusX="4" RadiusY="4"
                   SnapsToDevicePixels="True" />
        <StackPanel Margin="32,36">
          <Path Data="{StaticResource Icon.Drop}"
                Width="32" Height="32"
                Stretch="Uniform"
                Fill="{StaticResource Brush.Accent.Light}"
                HorizontalAlignment="Center"
                SnapsToDevicePixels="True" />
          <TextBlock Style="{StaticResource Text.H2}"
                     Text="Drop to install"
                     HorizontalAlignment="Center"
                     Margin="0,16,0,6" />
          <TextBlock Style="{StaticResource Text.Secondary}"
                     Text="Archives (.zip, .7z, .rar) or .pak/.ucas/.utoc files"
                     HorizontalAlignment="Center"
                     TextAlignment="Center"
                     TextWrapping="Wrap" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
