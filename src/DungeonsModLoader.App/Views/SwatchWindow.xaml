<Window x:Class="DungeonsModLoader.App.Views.SwatchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:DungeonsModLoader.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:SwatchViewModel, IsDesignTimeCreatable=False}"
        Title="{Binding WindowTitle}"
        Width="1100" Height="780" MinWidth="800" MinHeight="500"
        Background="{StaticResource Brush.Window.Background}"
        FontFamily="{StaticResource Font.Body}"
        FontSize="{StaticResource FontSize.Body}"
        Foreground="{StaticResource Brush.Text.Primary}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

  <!--
    Theme review window (dev tool, standard system chrome).
    - Palette / typography / shape data is enumerated from the live resource dictionaries by SwatchViewModel.
    - Control styles are consumed via DynamicResource so a key that is not merged yet renders unstyled
      instead of crashing (Themes/Controls.xaml is written by the theme work).
    - Margins use the Space.* scale (4 / 8 / 12 / 16 / 24 / 32) as literal device-independent units,
      because Space.* tokens are doubles and Margin needs a Thickness.
  -->

  <Window.Resources>
    <!-- Section: H2 header with a 2px accent rule, then the content. -->
    <Style x:Key="Swatch.Section" TargetType="HeaderedContentControl">
      <Setter Property="Margin" Value="0,0,0,32" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="HeaderedContentControl">
            <StackPanel>
              <TextBlock Text="{TemplateBinding Header}" Style="{StaticResource Text.H2}" />
              <Border Height="2" Margin="0,8,0,16" Background="{StaticResource Brush.Accent}" />
              <ContentPresenter />
            </StackPanel>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Sub-group label inside a section ("Backgrounds", "Buttons", ...). -->
    <Style x:Key="Swatch.GroupLabel" TargetType="TextBlock" BasedOn="{StaticResource Text.Label}">
      <Setter Property="Margin" Value="0,4,0,8" />
    </Style>

    <!-- Caption under a sample: monospace token value. -->
    <Style x:Key="Swatch.MonoCaption" TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
      <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
    </Style>

    <!-- Row of samples that wraps at the window edge. -->
    <ItemsPanelTemplate x:Key="Swatch.WrapPanel">
      <WrapPanel />
    </ItemsPanelTemplate>

    <!-- 16px gear used for the icon button (Material Design "settings" glyph, Apache 2.0). -->
    <Geometry x:Key="Swatch.GearGeometry">M19.14,12.94c0.04-0.3,0.06-0.61,0.06-0.94c0-0.32-0.02-0.64-0.07-0.94l2.03-1.58c0.18-0.14,0.23-0.41,0.12-0.61l-1.92-3.32c-0.12-0.22-0.37-0.29-0.59-0.22l-2.39,0.96c-0.5-0.38-1.03-0.7-1.62-0.94L14.4,2.81c-0.04-0.24-0.24-0.41-0.48-0.41h-3.84c-0.24,0-0.43,0.17-0.47,0.41L9.25,5.35C8.66,5.59,8.12,5.92,7.63,6.29L5.24,5.33c-0.22-0.08-0.47,0-0.59,0.22L2.74,8.87C2.62,9.08,2.66,9.34,2.86,9.48l2.03,1.58C4.84,11.36,4.8,11.69,4.8,12s0.02,0.64,0.07,0.94l-2.03,1.58c-0.18,0.14-0.23,0.41-0.12,0.61l1.92,3.32c0.12,0.22,0.37,0.29,0.59,0.22l2.39-0.96c0.5,0.38,1.03,0.7,1.62,0.94l0.36,2.54c0.05,0.24,0.24,0.41,0.48,0.41h3.84c0.24,0,0.44-0.17,0.47-0.41l0.36-2.54c0.59-0.24,1.13-0.56,1.62-0.94l2.39,0.96c0.22,0.08,0.47,0,0.59-0.22l1.92-3.32c0.12-0.22,0.07-0.47-0.12-0.61L19.14,12.94z M12,15.6c-1.98,0-3.6-1.62-3.6-3.6s1.62-3.6,3.6-3.6s3.6,1.62,3.6,3.6S13.98,15.6,12,15.6z</Geometry>
  </Window.Resources>

  <ScrollViewer x:Name="Scroller"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled"
                Padding="{StaticResource Padding.Page}"
                Focusable="False">
    <StackPanel>

      <!-- ===================================================== Header ===================================================== -->
      <Grid Margin="0,0,0,32">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Image Source="pack://application:,,,/Assets/Images/Logo.png"
               Height="64"
               Stretch="Uniform"
               VerticalAlignment="Center"
               RenderOptions.BitmapScalingMode="HighQuality" />
        <StackPanel Grid.Column="1" Margin="24,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="Theme swatches" Style="{StaticResource Text.H1}" />
          <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Text.Secondary}" Margin="0,4,0,0" />
        </StackPanel>
      </Grid>

      <!-- ===================================================== 1. Palette ===================================================== -->
      <HeaderedContentControl Style="{StaticResource Swatch.Section}" Header="Palette">
        <StackPanel>
          <ItemsControl ItemsSource="{Binding ColorGroups}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="0,0,0,8">
                  <TextBlock Text="{Binding Name}" Style="{StaticResource Swatch.GroupLabel}" />
                  <ItemsControl ItemsSource="{Binding Colors}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel ItemWidth="136" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <StackPanel Margin="0,0,0,12">
                          <Border Width="112" Height="64"
                                  HorizontalAlignment="Left"
                                  Background="{Binding Brush}"
                                  BorderBrush="{StaticResource Brush.Border.Strong}"
                                  BorderThickness="{StaticResource Thickness.Border.Thin}"
                                  CornerRadius="{StaticResource Radius.Small}" />
                          <TextBlock Text="{Binding Key}" Style="{StaticResource Text.Small}" Margin="0,6,0,0" />
                          <TextBlock Text="{Binding Hex}" Style="{StaticResource Swatch.MonoCaption}" />
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock Text="Gradients &amp; effects" Style="{StaticResource Swatch.GroupLabel}" />
          <ItemsControl ItemsSource="{Binding Gradients}" ItemsPanel="{StaticResource Swatch.WrapPanel}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="0,0,16,12">
                  <Border Width="240" Height="40"
                          Background="{Binding Brush}"
                          BorderBrush="{StaticResource Brush.Border.Strong}"
                          BorderThickness="{StaticResource Thickness.Border.Thin}"
                          CornerRadius="{StaticResource Radius.Small}" />
                  <TextBlock Text="{Binding Key}" Style="{StaticResource Text.Small}" Margin="0,6,0,0" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <ItemsControl ItemsSource="{Binding Effects}" ItemsPanel="{StaticResource Swatch.WrapPanel}" Margin="0,8,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="0,0,24,12">
                  <!-- Outer margin leaves room for the 16px blur so neighbours do not clip the glow. -->
                  <Border Width="64" Height="64"
                          Margin="12"
                          HorizontalAlignment="Left"
                          Background="{StaticResource Brush.Bg.PanelAlt}"
                          BorderBrush="{StaticResource Brush.Border.Strong}"
                          BorderThickness="{StaticResource Thickness.Border.Thin}"
                          CornerRadius="{StaticResource Radius.Medium}"
                          Effect="{Binding Effect}" />
                  <TextBlock Text="{Binding Key}" Style="{StaticResource Text.Small}" Margin="12,0,0,0" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </HeaderedContentControl>

      <!-- ===================================================== 2. Typography ===================================================== -->
      <HeaderedContentControl Style="{StaticResource Swatch.Section}" Header="Typography">
        <StackPanel Grid.IsSharedSizeScope="True">
          <ItemsControl ItemsSource="{Binding TypographySamples}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,0,0,10">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="TypographyDetails" />
                  </Grid.ColumnDefinitions>
                  <!-- Style comes from the view model so the row renders exactly like the real token. -->
                  <TextBlock Text="{Binding Sample}" Style="{Binding Style}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1"
                             Text="{Binding Details}"
                             Style="{StaticResource Text.Caption}"
                             Margin="24,0,0,0"
                             VerticalAlignment="Center" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock Text="Font families" Style="{StaticResource Swatch.GroupLabel}" Margin="0,12,0,8" />
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" SharedSizeGroup="FontLabel" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="Pixelify Sans (Font.Display)" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="0,0,24,8" />
            <ItemsControl Grid.Column="1" ItemsSource="{Binding DisplayFontWeights}" ItemsPanel="{StaticResource Swatch.WrapPanel}" Margin="0,0,0,8">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Label}"
                             FontFamily="{Binding Family}"
                             FontWeight="{Binding Weight}"
                             FontSize="{StaticResource FontSize.H2}"
                             Foreground="{StaticResource Brush.Text.Primary}"
                             Margin="0,0,24,0" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Grid.Row="1" Text="Inter (Font.Body)" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="0,0,24,0" />
            <ItemsControl Grid.Row="1" Grid.Column="1" ItemsSource="{Binding BodyFontWeights}" ItemsPanel="{StaticResource Swatch.WrapPanel}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Label}"
                             FontFamily="{Binding Family}"
                             FontWeight="{Binding Weight}"
                             FontSize="{StaticResource FontSize.H2}"
                             Foreground="{StaticResource Brush.Text.Primary}"
                             Margin="0,0,24,0" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Grid>
        </StackPanel>
      </HeaderedContentControl>

      <!-- ===================================================== 3. Controls ===================================================== -->
      <!-- Every style key below is provided by Themes/Controls.xaml and consumed via DynamicResource. -->
      <HeaderedContentControl Style="{StaticResource Swatch.Section}" Header="Controls">
        <StackPanel>

          <TextBlock Text="Buttons" Style="{StaticResource Swatch.GroupLabel}" />
          <WrapPanel>
            <Button Style="{DynamicResource Button.Primary}" Content="Install" Margin="0,0,12,12" />
            <Button Style="{DynamicResource Button.Secondary}" Content="Open folder" Margin="0,0,12,12" />
            <Button Style="{DynamicResource Button.Danger}" Content="Uninstall" Margin="0,0,12,12" />
            <Button Style="{DynamicResource Button.Ghost}" Content="Cancel" Margin="0,0,12,12" />
            <Button Style="{DynamicResource Button.Icon}" ToolTip="Settings" Margin="0,0,12,12">
              <Path Data="{StaticResource Swatch.GearGeometry}"
                    Width="16" Height="16"
                    Stretch="Uniform"
                    Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
            </Button>
            <Button Style="{DynamicResource Button.Play}" Content="PLAY" Margin="0,0,12,12" />
            <Button Style="{DynamicResource Button.Primary}" Content="Install" IsEnabled="False" Margin="0,0,12,12" />
            <Button Style="{DynamicResource Button.Secondary}" Content="Open folder" IsEnabled="False" Margin="0,0,12,12" />
          </WrapPanel>

          <TextBlock Text="Toggle switch" Style="{StaticResource Swatch.GroupLabel}" />
          <WrapPanel>
            <ToggleButton Style="{DynamicResource ToggleSwitch}" Margin="0,0,16,12" VerticalAlignment="Center" />
            <ToggleButton Style="{DynamicResource ToggleSwitch}" IsChecked="True" Margin="0,0,16,12" VerticalAlignment="Center" />
            <ToggleButton Style="{DynamicResource ToggleSwitch}" IsChecked="True" Content="Enabled" Margin="0,0,16,12" VerticalAlignment="Center" />
            <ToggleButton Style="{DynamicResource ToggleSwitch}" IsChecked="True" IsEnabled="False" Margin="0,0,16,12" VerticalAlignment="Center" />
          </WrapPanel>

          <TextBlock Text="Filter chips" Style="{StaticResource Swatch.GroupLabel}" />
          <WrapPanel>
            <RadioButton Style="{DynamicResource Chip}" GroupName="Filters" Content="All" IsChecked="True" Margin="0,0,8,12" />
            <RadioButton Style="{DynamicResource Chip}" GroupName="Filters" Content="Enabled" Margin="0,0,8,12" />
            <RadioButton Style="{DynamicResource Chip}" GroupName="Filters" Content="Disabled" Margin="0,0,8,12" />
            <RadioButton Style="{DynamicResource Chip}" GroupName="Filters" Content="Updates available" Margin="0,0,8,12" />
          </WrapPanel>

          <TextBlock Text="Inputs" Style="{StaticResource Swatch.GroupLabel}" />
          <!--
            TODO(integrator): Tag="..." on the three inputs below is a stand-in for the watermark attached property
            controls:TextBoxHelper.Placeholder="..." (xmlns:controls="clr-namespace:DungeonsModLoader.App.Controls"),
            which is created by the theme work and is not available in this worktree yet.
          -->
          <WrapPanel>
            <TextBox Tag="Display name" Width="220" Margin="0,0,12,12" VerticalAlignment="Center" />
            <TextBox Text="SecondSkinLayer" Width="220" Margin="0,0,12,12" VerticalAlignment="Center" />
            <TextBox Style="{DynamicResource TextBox.Search}" Tag="Search mods..." Width="260" Margin="0,0,12,12" VerticalAlignment="Center" />
            <PasswordBox Tag="API key" Width="220" Margin="0,0,12,12" VerticalAlignment="Center" />
            <ComboBox ItemsSource="{Binding ComboItems}" SelectedIndex="0" Width="180" Margin="0,0,12,12" VerticalAlignment="Center" />
          </WrapPanel>
          <WrapPanel>
            <CheckBox Content="Register as nxm:// handler" IsChecked="True" Margin="0,0,24,12" VerticalAlignment="Center" />
            <CheckBox Content="Check for updates on startup" Margin="0,0,24,12" VerticalAlignment="Center" />
            <RadioButton GroupName="Launch" Content="Launch through Steam" IsChecked="True" Margin="0,0,24,12" VerticalAlignment="Center" />
            <RadioButton GroupName="Launch" Content="Launch the executable" Margin="0,0,24,12" VerticalAlignment="Center" />
          </WrapPanel>

          <TextBlock Text="Progress" Style="{StaticResource Swatch.GroupLabel}" />
          <WrapPanel>
            <ProgressBar Value="35" Width="240" Margin="0,0,24,12" VerticalAlignment="Center" />
            <ProgressBar IsIndeterminate="True" Width="240" Margin="0,0,24,12" VerticalAlignment="Center" />
          </WrapPanel>

          <TextBlock Text="Lists &amp; scrolling" Style="{StaticResource Swatch.GroupLabel}" />
          <WrapPanel>
            <ListBox ItemsSource="{Binding ListItems}" SelectedIndex="1" Width="320" Margin="0,0,24,12" VerticalAlignment="Top" />
            <Border Width="320" Height="120"
                    Margin="0,0,24,12"
                    Background="{StaticResource Brush.Bg.Input}"
                    BorderBrush="{StaticResource Brush.Border}"
                    BorderThickness="{StaticResource Thickness.Border.Thin}"
                    CornerRadius="{StaticResource Radius.Small}">
              <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="12,8">
                <TextBlock Text="{Binding ScrollSampleText}" Style="{StaticResource Text.Body}" />
              </ScrollViewer>
            </Border>
          </WrapPanel>

          <TextBlock Text="Badges" Style="{StaticResource Swatch.GroupLabel}" />
          <WrapPanel>
            <Border Style="{DynamicResource Badge}" Margin="0,0,8,12" VerticalAlignment="Center"><TextBlock Text="Default" /></Border>
            <Border Style="{DynamicResource Badge.Accent}" Margin="0,0,8,12" VerticalAlignment="Center"><TextBlock Text="Nexus" /></Border>
            <Border Style="{DynamicResource Badge.Success}" Margin="0,0,8,12" VerticalAlignment="Center"><TextBlock Text="Enabled" /></Border>
            <Border Style="{DynamicResource Badge.Warning}" Margin="0,0,8,12" VerticalAlignment="Center"><TextBlock Text="Update available" /></Border>
            <Border Style="{DynamicResource Badge.Danger}" Margin="0,0,8,12" VerticalAlignment="Center"><TextBlock Text="Missing" /></Border>
            <Border Style="{DynamicResource Badge.Cyan}" Margin="0,0,8,12" VerticalAlignment="Center"><TextBlock Text="Local" /></Border>
            <Border Style="{DynamicResource Badge.Purple}" Margin="0,0,8,12" VerticalAlignment="Center"><TextBlock Text="Premium" /></Border>
          </WrapPanel>

          <TextBlock Text="Card (mod row)" Style="{StaticResource Swatch.GroupLabel}" />
          <Border Style="{DynamicResource Card}" MaxWidth="560" HorizontalAlignment="Left" Margin="0,0,0,12">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <!-- Thumbnail placeholder (local mods have no Nexus image). -->
              <Border Width="48" Height="48"
                      Background="{StaticResource Brush.Bg.PanelAlt}"
                      BorderBrush="{StaticResource Brush.Border.Strong}"
                      BorderThickness="{StaticResource Thickness.Border.Thin}"
                      CornerRadius="{StaticResource Radius.Small}" />
              <StackPanel Grid.Column="1" Margin="12,0,16,0" VerticalAlignment="Center">
                <TextBlock Text="SecondSkinLayer" Style="{StaticResource Text.H3}" />
                <TextBlock Text="by Boosterfrank · v1.2.0" Style="{StaticResource Text.Small}" Margin="0,2,0,0" />
              </StackPanel>
              <Border Grid.Column="2" Style="{DynamicResource Badge.Accent}" Margin="0,0,16,0" VerticalAlignment="Center"><TextBlock Text="Nexus" /></Border>
              <ToggleButton Grid.Column="3" Style="{DynamicResource ToggleSwitch}" IsChecked="True" VerticalAlignment="Center" />
            </Grid>
          </Border>

          <TextBlock Text="Tooltip, context menu &amp; link" Style="{StaticResource Swatch.GroupLabel}" />
          <WrapPanel>
            <Button Content="Hover for tooltip" ToolTip="Installs the selected file into ~mods" Margin="0,0,12,12" VerticalAlignment="Center" />
            <Button Content="Right-click for menu" Margin="0,0,12,12" VerticalAlignment="Center">
              <Button.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="Open on Nexus" />
                  <MenuItem Header="Open folder" InputGestureText="Ctrl+O" />
                  <Separator />
                  <MenuItem Header="Uninstall" />
                </ContextMenu>
              </Button.ContextMenu>
            </Button>
            <TextBlock Style="{StaticResource Text.Body}" Margin="12,0,12,12" VerticalAlignment="Center">
              <Hyperlink NavigateUri="https://www.nexusmods.com/">Open on Nexus</Hyperlink>
            </TextBlock>
          </WrapPanel>
        </StackPanel>
      </HeaderedContentControl>

      <!-- ===================================================== 4. Shape ===================================================== -->
      <HeaderedContentControl Style="{StaticResource Swatch.Section}" Header="Shape">
        <ItemsControl ItemsSource="{Binding Shapes}" ItemsPanel="{StaticResource Swatch.WrapPanel}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel Margin="0,0,24,12">
                <!-- 1px bevel all round, 3px extruded bottom edge (Size.Extrude), light bevel on the top-left. -->
                <Border Width="120" Height="72"
                        HorizontalAlignment="Left"
                        Background="{StaticResource Brush.Bg.PanelAlt}"
                        BorderBrush="{StaticResource Brush.Bevel.Dark}"
                        BorderThickness="{Binding BorderThickness}"
                        CornerRadius="{Binding Radius}">
                  <Border BorderBrush="{StaticResource Brush.Bevel.Light}"
                          BorderThickness="1,1,0,0"
                          CornerRadius="{Binding Radius}"
                          Opacity="0.7" />
                </Border>
                <TextBlock Text="{Binding Key}" Style="{StaticResource Text.Small}" Margin="0,8,0,0" />
                <TextBlock Text="{Binding Details}" Style="{StaticResource Swatch.MonoCaption}" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </HeaderedContentControl>

    </StackPanel>
  </ScrollViewer>
</Window>
