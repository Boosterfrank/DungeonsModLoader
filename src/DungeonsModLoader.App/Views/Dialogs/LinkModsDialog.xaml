<Window x:Class="DungeonsModLoader.App.Views.Dialogs.LinkModsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dialogs="clr-namespace:DungeonsModLoader.App.Views.Dialogs"
        Title="Link mods to Nexus Mods"
        Width="780" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="False"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource Brush.Bg.Panel}"
        Foreground="{StaticResource Brush.Text.Primary}"
        FontFamily="{StaticResource Font.Body}"
        FontSize="{StaticResource FontSize.Body}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Loaded="OnLoaded"
        Closing="OnClosing">

  <!--
    Same anatomy as the other dialogs: borderless, draggable header, body, footer. The body (LinkModsView) is
    shared with the first-run wizard. DataContext: LinkModsViewModel.
  -->
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="0" CornerRadius="0" GlassFrameThickness="0,0,0,1"
                  ResizeBorderThickness="0" UseAeroCaptionButtons="False" />
  </WindowChrome.WindowChrome>

  <Border Background="{StaticResource Brush.Bg.Panel}"
          BorderBrush="{StaticResource Brush.Border.Strong}"
          BorderThickness="{StaticResource Thickness.Border.Thin}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- Header (draggable) -->
      <Border Grid.Row="0" Background="Transparent" Padding="24,20,24,0" MouseLeftButtonDown="OnHeaderMouseLeftButtonDown">
        <StackPanel>
          <TextBlock Style="{StaticResource Text.H2}" Text="Link mods to Nexus Mods" TextWrapping="Wrap" />
          <TextBlock Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,6,0,0"
                     Text="Mods you installed by hand do not know their page on Nexus Mods yet. Linking them turns on update notices and requirement hints; the files stay exactly as they are." />
        </StackPanel>
      </Border>

      <!-- Body -->
      <ScrollViewer Grid.Row="1" Margin="24,18,24,0" Padding="0,0,4,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <dialogs:LinkModsView />
      </ScrollViewer>

      <!-- Footer -->
      <Border Grid.Row="2" BorderBrush="{StaticResource Brush.Border.Subtle}" BorderThickness="0,1,0,0" Padding="24,14,24,18" Margin="0,16,0,0">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center"
                      Visibility="{Binding IsApplying, Converter={StaticResource Converter.BoolToVisibility}}">
            <ProgressBar Width="120" IsIndeterminate="True" VerticalAlignment="Center" />
            <TextBlock Style="{StaticResource Text.Small}" Text="{Binding BusyText}" VerticalAlignment="Center" Margin="10,0,0,0" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal">
            <Button Style="{DynamicResource Button.Ghost}" Content="Close" Command="{Binding CancelCommand}" IsCancel="True" Margin="0,0,8,0"
                    AutomationProperties.Name="Close" />
            <Button Style="{DynamicResource Button.Primary}" Content="{Binding LinkButtonText}" Command="{Binding ApplyAndCloseCommand}" IsDefault="True" MinWidth="130"
                    AutomationProperties.Name="Link selected mods" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>
