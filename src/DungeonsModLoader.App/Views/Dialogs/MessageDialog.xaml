<Window x:Class="DungeonsModLoader.App.Views.Dialogs.MessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Message"
        Width="520" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="False"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource Brush.Bg.Panel}"
        Foreground="{StaticResource Brush.Text.Primary}"
        FontFamily="{StaticResource Font.Body}"
        FontSize="{StaticResource FontSize.Body}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Loaded="OnLoaded">

  <!--
    Themed message box (Info / Error / Confirm). Same anatomy as CrashDialog: borderless, draggable header,
    body, footer with right-aligned actions, extruded bottom edge. Filled from code-behind (Present).
  -->
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="0" CornerRadius="0" GlassFrameThickness="0,0,0,1"
                  ResizeBorderThickness="0" UseAeroCaptionButtons="False" />
  </WindowChrome.WindowChrome>

  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="MessageDialog.BoolToVisibility" />

    <!-- "Details" disclosure: link-coloured text with a chevron that turns when expanded. -->
    <Style x:Key="MessageDialog.DetailsToggle" TargetType="ToggleButton">
      <Setter Property="Foreground" Value="{StaticResource Brush.Text.Link}" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="Bd" Background="Transparent" Padding="2,4,2,2"
                    BorderThickness="0,0,0,1" BorderBrush="Transparent">
              <StackPanel Orientation="Horizontal">
                <Path x:Name="Chevron" Width="8" Height="8" Margin="0,1,8,0"
                      Data="M0,0 L4,4 L0,8 Z" Stretch="Uniform" VerticalAlignment="Center"
                      Fill="{TemplateBinding Foreground}" RenderTransformOrigin="0.5,0.5" />
                <ContentPresenter VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
              </StackPanel>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Chevron" Property="RenderTransform">
                  <Setter.Value>
                    <RotateTransform Angle="90" />
                  </Setter.Value>
                </Setter>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.Text.Link}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.Cyan}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Read-only monospace details box. Self-contained so the shared single-line TextBox style never applies. -->
    <Style x:Key="MessageDialog.DetailsBox" TargetType="TextBox">
      <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
      <Setter Property="FontSize" Value="{StaticResource FontSize.Small}" />
      <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}" />
      <Setter Property="Background" Value="{StaticResource Brush.Bg.Input}" />
      <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
      <Setter Property="BorderThickness" Value="{StaticResource Thickness.Border.Thin}" />
      <Setter Property="CaretBrush" Value="{StaticResource Brush.Cyan}" />
      <Setter Property="SelectionBrush" Value="{StaticResource Brush.Cyan}" />
      <Setter Property="SelectionOpacity" Value="0.35" />
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="Height" Value="160" />
      <Setter Property="IsReadOnly" Value="True" />
      <Setter Property="IsReadOnlyCaretVisible" Value="False" />
      <Setter Property="AcceptsReturn" Value="True" />
      <Setter Property="TextWrapping" Value="NoWrap" />
      <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
      <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{StaticResource Radius.Small}" SnapsToDevicePixels="True">
              <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" Focusable="False" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.Cyan}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Border Background="{StaticResource Brush.Bg.Panel}"
          BorderBrush="{StaticResource Brush.Border.Strong}"
          BorderThickness="{StaticResource Thickness.Border.Thin}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- Header: draggable, no caption buttons (the footer actions are the only way out). -->
      <Border Grid.Row="0" Background="Transparent" Padding="24,20,24,0"
              MouseLeftButtonDown="OnHeaderMouseLeftButtonDown">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Border x:Name="IconBox" Grid.Column="0" Width="26" Height="26" VerticalAlignment="Center"
                  Background="{StaticResource Brush.Cyan.Faint}"
                  BorderBrush="{StaticResource Brush.Cyan}"
                  BorderThickness="{StaticResource Thickness.Border.Thin}"
                  CornerRadius="{StaticResource Radius.Small}">
            <TextBlock x:Name="IconGlyph" Text="i" FontFamily="{StaticResource Font.Display}" FontWeight="Bold"
                       FontSize="{StaticResource FontSize.H2}" Foreground="{StaticResource Brush.Cyan}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0" />
          </Border>
          <TextBlock x:Name="TitleText" Grid.Column="1" Style="{StaticResource Text.H2}"
                     TextWrapping="Wrap" TextTrimming="None"
                     VerticalAlignment="Center" Margin="12,0,0,0" />
        </Grid>
      </Border>

      <!-- Body -->
      <StackPanel Grid.Row="1" Margin="24,12,24,20">
        <TextBlock x:Name="MessageText" Style="{StaticResource Text.Body}"
                   Foreground="{StaticResource Brush.Text.Secondary}" TextTrimming="None" />
        <ToggleButton x:Name="DetailsToggle" Style="{StaticResource MessageDialog.DetailsToggle}"
                      Content="Details" Margin="0,16,0,0" Visibility="Collapsed" />
        <TextBox x:Name="DetailsBox" Style="{StaticResource MessageDialog.DetailsBox}" Margin="0,8,0,0"
                 Visibility="{Binding IsChecked, ElementName=DetailsToggle, Converter={StaticResource MessageDialog.BoolToVisibility}}" />
      </StackPanel>

      <!-- Footer: actions right-aligned; the single primary action sits last. -->
      <Border Grid.Row="2" Background="{StaticResource Brush.Bg.PanelAlt}"
              BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,1,0,0" Padding="24,16">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button x:Name="OpenLogsButton" Content="Open logs folder" Visibility="Collapsed"
                  Style="{DynamicResource Button.Secondary}" MinWidth="120" Margin="0,0,8,0"
                  Click="OnOpenLogsClick" />
          <Button x:Name="CancelButton" Content="Cancel" Visibility="Collapsed" IsCancel="True"
                  Style="{DynamicResource Button.Secondary}" MinWidth="100" Margin="0,0,8,0"
                  Click="OnCancelClick" />
          <Button x:Name="ConfirmButton" Content="OK" IsDefault="True"
                  Style="{DynamicResource Button.Primary}" MinWidth="100"
                  Click="OnConfirmClick" />
        </StackPanel>
      </Border>

      <!-- The "extruded" bottom edge shared by buttons and cards. -->
      <Border Grid.Row="3" Height="{StaticResource Size.Extrude}" Background="{StaticResource Brush.Bevel.Dark}" />
    </Grid>
  </Border>
</Window>
