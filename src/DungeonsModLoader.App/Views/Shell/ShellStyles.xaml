<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:shell="clr-namespace:DungeonsModLoader.App.Views.Shell">

  <!--
    Shell-only styles (merged by MainWindow): title-bar caption buttons and sidebar navigation items.
    Every colour / metric comes from Themes/Colors.xaml + Themes/Typography.xaml. Literal margins are Space.* multiples.
  -->

  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="pack://application:,,,/Views/Shell/Icons.xaml" />
  </ResourceDictionary.MergedDictionaries>

  <shell:ReferenceEqualityConverter x:Key="ReferenceEqualityConverter" />

  <!-- Cyan keyboard focus ring. WPF applies FocusVisualStyle only for keyboard navigation, never for mouse clicks. -->
  <Style x:Key="Shell.FocusVisual">
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <Rectangle Margin="2"
                     Stroke="{StaticResource Brush.Cyan}"
                     StrokeThickness="1"
                     RadiusX="2" RadiusY="2"
                     SnapsToDevicePixels="True" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============================ Caption buttons ============================ -->
  <!--
    46x40, transparent, 10px filled glyph (Content is a Geometry from Icons.xaml).
    BorderBrush doubles as the hover fill (Bg.PanelAlt; Danger for Close) so one template serves all three buttons.
    The maximize button is owned by the system while hovered (snap layouts, see WindowChromeHelper), so the template
    also reacts to WindowChromeHelper.IsChromeHovered / IsChromePressed exactly like IsMouseOver / IsPressed.
  -->
  <Style x:Key="CaptionButton" TargetType="Button">
    <Setter Property="Width" Value="46" />
    <Setter Property="Height" Value="{StaticResource Size.TitleBar.Height}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Bg.PanelAlt}" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
            <Border x:Name="Hover" Background="{TemplateBinding BorderBrush}" Opacity="0" />
            <Path x:Name="Glyph"
                  Width="10" Height="10"
                  Stretch="None"
                  Data="{TemplateBinding Content}"
                  Fill="{TemplateBinding Foreground}"
                  HorizontalAlignment="Center" VerticalAlignment="Center"
                  SnapsToDevicePixels="True" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource Duration.Fast}" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource Duration.Fast}" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="shell:WindowChromeHelper.IsChromeHovered" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource Duration.Fast}" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource Duration.Fast}" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Hover" Property="Opacity" Value="0.7" />
            </Trigger>
            <Trigger Property="shell:WindowChromeHelper.IsChromePressed" Value="True">
              <Setter TargetName="Hover" Property="Opacity" Value="0.7" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
      </Trigger>
      <Trigger Property="shell:WindowChromeHelper.IsChromeHovered" Value="True">
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="CaptionButton.Minimize" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
    <Setter Property="Content" Value="{StaticResource Glyph.Minimize}" />
  </Style>

  <Style x:Key="CaptionButton.Maximize" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
    <Setter Property="Content" Value="{StaticResource Glyph.Maximize}" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
        <Setter Property="Content" Value="{StaticResource Glyph.Restore}" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="CaptionButton.Close" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
    <Setter Property="Content" Value="{StaticResource Glyph.Close}" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Danger}" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- ============================ Sidebar navigation ============================ -->
  <!--
    RadioButton (GroupName Nav). shell:NavItem.Icon supplies the 16px glyph; Content is the label.
    Unchecked: transparent / Text.Secondary. Hover: Bg.PanelAlt / Text.Primary.
    Checked: Bg.PanelAlt / Text.Primary, 3px accent bar on the left edge, accent icon with a faint glow.
  -->
  <Style x:Key="NavItem" TargetType="RadioButton">
    <Setter Property="Height" Value="44" />
    <Setter Property="Padding" Value="16,0" />
    <Setter Property="FontFamily" Value="{StaticResource Font.Display}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.Nav}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource Shell.FocusVisual}" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Grid Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
            <Border x:Name="Selected" Background="{StaticResource Brush.Bg.PanelAlt}" Opacity="0" />
            <Border x:Name="Hover" Background="{StaticResource Brush.Bg.PanelAlt}" Opacity="0" />
            <Rectangle x:Name="Bar" Width="3" HorizontalAlignment="Left" Fill="{StaticResource Brush.Accent}" Opacity="0" />
            <StackPanel Orientation="Horizontal" Margin="{TemplateBinding Padding}" VerticalAlignment="Center">
              <Grid Width="16" Height="16" VerticalAlignment="Center">
                <Path x:Name="IconGlow"
                      Data="{Binding Path=(shell:NavItem.Icon), RelativeSource={RelativeSource TemplatedParent}}"
                      Fill="{StaticResource Brush.Accent}"
                      Stretch="Uniform"
                      Effect="{StaticResource Effect.Glow.Accent}"
                      Opacity="0" />
                <Path x:Name="Icon"
                      Data="{Binding Path=(shell:NavItem.Icon), RelativeSource={RelativeSource TemplatedParent}}"
                      Fill="{TemplateBinding Foreground}"
                      Stretch="Uniform"
                      SnapsToDevicePixels="True" />
              </Grid>
              <ContentPresenter Margin="12,0,0,0"
                                VerticalAlignment="Center"
                                RecognizesAccessKey="True"
                                SnapsToDevicePixels="True" />
            </StackPanel>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource Duration.Fast}" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource Duration.Fast}" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Icon" Property="Fill" Value="{StaticResource Brush.Accent.Light}" />
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Selected" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource Duration.Normal}" />
                    <DoubleAnimation Storyboard.TargetName="Bar" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource Duration.Normal}" />
                    <DoubleAnimation Storyboard.TargetName="IconGlow" Storyboard.TargetProperty="Opacity" To="0.6" Duration="{StaticResource Duration.Normal}" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Selected" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource Duration.Normal}" />
                    <DoubleAnimation Storyboard.TargetName="Bar" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource Duration.Normal}" />
                    <DoubleAnimation Storyboard.TargetName="IconGlow" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource Duration.Normal}" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
      </Trigger>
      <Trigger Property="IsChecked" Value="True">
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
      </Trigger>
    </Style.Triggers>
  </Style>

</ResourceDictionary>
