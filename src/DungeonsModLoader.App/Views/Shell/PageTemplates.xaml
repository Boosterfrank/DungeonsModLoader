<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:DungeonsModLoader.App.ViewModels.Pages"
                    xmlns:pages="clr-namespace:DungeonsModLoader.App.Views.Pages">

  <!-- Page view model -> page view. The shell's content control picks these up implicitly by DataType. -->

  <DataTemplate DataType="{x:Type vm:InstalledViewModel}">
    <pages:InstalledPage />
  </DataTemplate>

  <DataTemplate DataType="{x:Type vm:BrowseViewModel}">
    <pages:BrowsePage />
  </DataTemplate>

  <DataTemplate DataType="{x:Type vm:ProfilesViewModel}">
    <pages:ProfilesPage />
  </DataTemplate>

  <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
    <pages:SettingsPage />
  </DataTemplate>

</ResourceDictionary>
