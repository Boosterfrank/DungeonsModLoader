<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Shell glyphs drawn as path geometry (our own shapes, no game art).
    Icon.*  : 16x16 nav / empty-state icons. Integer coordinates so they stay crisp at 16px; vector, so they scale to 48px.
    Glyph.* : 10x10 caption-button glyphs (minimize / maximize / restore / close), filled (not stroked) so 1px edges land on pixels.
    Default fill rule is EvenOdd; "F1" switches to Nonzero where shapes overlap on purpose.
  -->

  <!-- Installed: 2x2 grid of squares -->
  <Geometry x:Key="Icon.Installed">M0,0 H7 V7 H0 Z M9,0 H16 V7 H9 Z M0,9 H7 V16 H0 Z M9,9 H16 V16 H9 Z</Geometry>

  <!-- Browse: compass ring with a NE/SW needle -->
  <Geometry x:Key="Icon.Browse">M0,8 A8,8 0 1 1 16,8 A8,8 0 1 1 0,8 Z M2,8 A6,6 0 1 1 14,8 A6,6 0 1 1 2,8 Z M11.5,4.5 L9.6,9.6 L4.5,11.5 L6.4,6.4 Z</Geometry>

  <!-- Profiles: two overlapping cards -->
  <Geometry x:Key="Icon.Profiles">M0,5 H11 V16 H0 Z M2,7 V14 H9 V7 Z M5,0 H16 V11 H11 V9 H14 V2 H7 V5 H5 Z</Geometry>

  <!-- Settings: 8-tooth gear -->
  <Geometry x:Key="Icon.Settings">M13.80,6.45 L15.88,6.61 L15.88,9.39 L13.80,9.55 L13.20,11.00 L14.55,12.59 L12.59,14.55 L11.00,13.20 L9.55,13.80 L9.39,15.88 L6.61,15.88 L6.45,13.80 L5.00,13.20 L3.41,14.55 L1.45,12.59 L2.80,11.00 L2.20,9.55 L0.12,9.39 L0.12,6.61 L2.20,6.45 L2.80,5.00 L1.45,3.41 L3.41,1.45 L5.00,2.80 L6.45,2.20 L6.61,0.12 L9.39,0.12 L9.55,2.20 L11.00,2.80 L12.59,1.45 L14.55,3.41 L13.20,5.00 Z M8,5.4 A2.6,2.6 0 1 1 8,10.6 A2.6,2.6 0 1 1 8,5.4 Z</Geometry>

  <!-- Play triangle (10x12) -->
  <Geometry x:Key="Icon.Play">M0,0 L10,6 L0,12 Z</Geometry>

  <!-- Search: magnifier -->
  <Geometry x:Key="Icon.Search">M6.5,0 A6.5,6.5 0 1 1 6.5,13 A6.5,6.5 0 1 1 6.5,0 Z M6.5,2 A4.5,4.5 0 1 0 6.5,11 A4.5,4.5 0 1 0 6.5,2 Z M10.5,12 L12,10.5 L16,14.5 L14.5,16 Z</Geometry>

  <!-- Pak: a pixel crate (lid band, hollow body, latch) - the mod thumbnail placeholder -->
  <Geometry x:Key="Icon.Pak">M0,2 H16 V5 H0 Z M1,6 H15 V16 H1 Z M3,8 V14 H13 V8 Z M6,8 H10 V11 H6 Z</Geometry>

  <!-- Drop: a down arrow landing in a hollow tray (32x32) - the drag & drop overlay -->
  <Geometry x:Key="Icon.Drop">M13,2 H19 V15 H13 Z M7,15 H25 L16,24 Z M3,20 H29 V31 H3 Z M6,20 H26 V28 H6 Z</Geometry>

  <!-- Caption buttons (10x10) -->
  <Geometry x:Key="Glyph.Minimize">M0,5 H10 V6 H0 Z</Geometry>
  <Geometry x:Key="Glyph.Maximize">M0,0 H10 V10 H0 Z M1,1 V9 H9 V1 Z</Geometry>
  <Geometry x:Key="Glyph.Restore">M2,0 H10 V8 H8 V7 H9 V1 H3 V2 H2 Z M0,2 H8 V10 H0 Z M1,3 V9 H7 V3 Z</Geometry>
  <Geometry x:Key="Glyph.Close">F1 M0.75,0 L10,9.25 L9.25,10 L0,0.75 Z M9.25,0 L10,0.75 L0.75,10 L0,9.25 Z</Geometry>

</ResourceDictionary>
