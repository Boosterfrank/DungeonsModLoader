<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Shared page building blocks, merged by each page UserControl (pages are constructed before they join the
    window's tree, so they cannot see MainWindow.Resources via StaticResource).
    Header = Text.H1 title + Page.Subtitle; empty state = EmptyState.Icon + EmptyState.Headline + one call to action.
  -->

  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="pack://application:,,,/Views/Shell/Icons.xaml" />
  </ResourceDictionary.MergedDictionaries>

  <Style x:Key="Page.Subtitle" TargetType="TextBlock" BasedOn="{StaticResource Text.Secondary}">
    <Setter Property="Margin" Value="0,4,0,0" />
  </Style>

  <Style x:Key="EmptyState.Icon" TargetType="Path">
    <Setter Property="Width" Value="48" />
    <Setter Property="Height" Value="48" />
    <Setter Property="Stretch" Value="Uniform" />
    <Setter Property="Fill" Value="{StaticResource Brush.Text.Muted}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="Margin" Value="0,0,0,16" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
  </Style>

  <Style x:Key="EmptyState.Headline" TargetType="TextBlock" BasedOn="{StaticResource Text.H2}">
    <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}" />
    <Setter Property="TextAlignment" Value="Center" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Margin" Value="0,0,0,24" />
  </Style>

</ResourceDictionary>
